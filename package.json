{
  "name": "once-upon-a-time",
  "version": "0.1.0",
  "private": true,
  "description": "Once Upon A Time, Inc. — Shopify Dawn theme + static demo. Tailwind, GSAP, Prettier (Shopify Liquid).",
  "scripts": {
    "css:build": "tailwindcss -c tailwind.config.js -i ./src/tailwind.css -o ./once-upon-a-time-assets/styles/tailwind.css --minify",
    "css:watch": "tailwindcss -c tailwind.config.js -i ./src/tailwind.css -o ./once-upon-a-time-assets/styles/tailwind.css --watch",
    "theme:css:build": "tailwindcss -c tailwind.config.js -i ./src/tailwind.css -o ./shopify-theme/assets/tailwind.css --minify",
    "theme:css:watch": "tailwindcss -c tailwind.config.js -i ./src/tailwind.css -o ./shopify-theme/assets/tailwind.css --watch",
    "build": "npm run css:build && npm run theme:css:build",
    "format": "prettier --write '**/*.{liquid,json,md,css,html,js}'",
    "format:check": "prettier --check '**/*.{liquid,json,md,css,html,js}'",
    "theme:dev": "cd shopify-theme && shopify theme dev",
    "theme:push": "cd shopify-theme && shopify theme push --unpublished"
  },
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "^1.4.4",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1"
  },
  "dependencies": {
    "gsap": "^3.12.5"
  },
  "engines": {
    "node": ">=18"
  }
}
