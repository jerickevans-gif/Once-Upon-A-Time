<style>
body { background: var(--beginning); font-family: var(--sans); color: var(--ink); margin: 0; }
    .receipt-wrap { max-width: 820px; margin: 40px auto; padding: 0 24px; }
    .receipt-toolbar {
      display: flex; gap: 12px; justify-content: space-between; align-items: center;
      margin-bottom: 24px; flex-wrap: wrap;
    }
    .receipt-toolbar a, .receipt-toolbar button {
      background: var(--snow); border: 1px solid var(--line);
      color: var(--ink); border-radius: 8px;
      padding: 10px 18px; font-size: 14px; font-weight: 600;
      cursor: pointer; text-decoration: none;
      display: inline-flex; align-items: center; gap: 8px;
    }
    .receipt-toolbar a:hover, .receipt-toolbar button:hover { background: var(--rose-50); border-color: var(--rose-300); }
    .receipt-toolbar .btn-primary { background: var(--button-primary); color: var(--snow); border-color: var(--button-primary); }
    .receipt-toolbar .btn-primary:hover { background: var(--pillar-700); border-color: var(--pillar-700); }

    .receipt {
      background: var(--snow);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 48px;
      box-shadow: 0 4px 20px rgba(76,47,59,.08);
    }
    .receipt__head {
      display: flex; align-items: flex-start; justify-content: space-between;
      gap: 24px; padding-bottom: 32px; border-bottom: 2px solid var(--rose-100);
      margin-bottom: 32px;
      flex-wrap: wrap;
    }
    .receipt__brand img { height: 80px; }
    .receipt__brand-meta {
      font-size: 12px; color: var(--ink-muted); line-height: 1.5;
      margin-top: 8px;
    }
    .receipt__title-block { text-align: right; }
    .receipt__eyebrow {
      font-size: 11px; font-weight: 700; letter-spacing: .25em;
      color: var(--rose-700); text-transform: uppercase;
      margin-bottom: 6px;
    }
    .receipt__title {
      font-family: var(--serif); font-weight: 600;
      font-size: 32px;
      margin: 0 0 12px;
      color: var(--pillar);
      text-transform: uppercase;
    }
    .receipt__order-id {
      font-family: 'SFMono-Regular', ui-monospace, Menlo, monospace;
      font-size: 13px; color: var(--ink-muted);
    }

    .receipt__meta {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
      margin-bottom: 32px;
    }
    .receipt__meta-block { display: flex; flex-direction: column; gap: 4px; }
    .receipt__meta-label { font-size: 12px; font-weight: 600; color: var(--ink-muted); text-transform: uppercase; letter-spacing: .04em; }
    .receipt__meta-value { font-size: 14px; color: var(--ink); font-weight: 500; }

    .receipt__items {
      width: 100%; border-collapse: collapse;
      margin-bottom: 24px;
    }
    .receipt__items th {
      text-align: left; padding: 12px 8px;
      border-bottom: 1.5px solid var(--ink);
      font-size: 11px; text-transform: uppercase; font-weight: 700;
      letter-spacing: .04em; color: var(--ink-muted);
    }
    .receipt__items th:last-child, .receipt__items td:last-child { text-align: right; }
    .receipt__items td {
      padding: 16px 8px;
      border-bottom: 1px solid var(--line);
      font-size: 14px; color: var(--ink); vertical-align: top;
    }
    .receipt__items td .item-meta {
      display: block; font-size: 12px; color: var(--ink-muted);
      margin-top: 4px;
    }

    .receipt__totals {
      margin-left: auto; max-width: 320px;
      display: grid; gap: 8px;
      padding: 16px 0;
    }
    .receipt__total-row {
      display: flex; justify-content: space-between;
      font-size: 14px; color: var(--ink-muted);
    }
    .receipt__total-row--grand {
      font-size: 18px; font-weight: 700; color: var(--ink);
      border-top: 1.5px solid var(--ink); padding-top: 12px; margin-top: 8px;
    }
    .receipt__total-row--grand strong { font-family: var(--serif); font-weight: 600; }

    .receipt__payment {
      display: flex; align-items: center; gap: 12px;
      background: var(--rose-50); padding: 14px 18px; border-radius: var(--radius);
      margin-top: 24px; font-size: 13px;
    }
    .receipt__payment .ph { font-size: 20px; color: var(--rose-700); }

    .receipt__notes {
      margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--line);
      font-size: 12px; color: var(--ink-muted); line-height: 1.6;
    }
    .receipt__notes p { margin: 0 0 8px; }
    .receipt__notes strong { color: var(--ink); }

    .receipt__footer {
      margin-top: 32px; text-align: center;
      font-size: 11px; color: var(--ink-muted); letter-spacing: .04em;
      padding-top: 24px; border-top: 1px solid var(--line);
    }

    /* Print styles */
    @media print {
      .receipt-toolbar { display: none; }
      body { background: var(--snow); }
      .receipt { box-shadow: none; border: 0; padding: 24px; border-radius: 0; }
      .receipt-wrap { margin: 0; padding: 0; }
    }
    @media (max-width: 720px) {
      .receipt { padding: 28px 22px; }
      .receipt__head { flex-direction: column; }
      .receipt__title-block { text-align: left; }
      .receipt__meta { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 480px) {
      .receipt-wrap { padding: 0 12px; }
      .receipt { padding: 20px 16px; }
      .receipt__meta { grid-template-columns: 1fr; }
      .receipt__title { font-size: 22px; }
      .receipt__brand img { height: 56px; }
      .receipt__items th, .receipt__items td { padding: 10px 6px; }
      .receipt__items td .item-meta { font-size: 11px; }
    }
</style>

<div class="receipt-toolbar">
      <a href="class-history.html"><i class="ph ph-arrow-left"></i> Back to Class History</a>
      <div style="display:flex;gap:8px">
        <button type="button" data-print><i class="ph ph-printer"></i> Print</button>
        <button type="button" class="btn-primary" data-mock="download-pdf" data-mock-toast="PDF download is generated server-side via Shopify in production."><i class="ph ph-download-simple"></i> Download PDF</button>
      </div>
    </div>

    <article class="receipt" id="receipt">
      <header class="receipt__head">
        <div class="receipt__brand">
          <img src="once-upon-a-time-assets/logo/full-icon.png" alt="Once Upon A Time">
          <div class="receipt__brand-meta">
            Once Upon A Time, Inc.<br>
            87-61 111th St, Richmond Hill, NY 11418<br>
            +1-718-380-6929 · contact@onceuponatime.org<br>
            EIN: XX-XXXXXXX · 501(c)(3) nonprofit
          </div>
        </div>
        <div class="receipt__title-block">
          <div class="receipt__eyebrow">Receipt</div>
          <h1 class="receipt__title">Order Confirmed</h1>
          <div class="receipt__order-id" id="order-id">#OUAT-2026-001</div>
        </div>
      </header>

      <div class="receipt__meta">
        <div class="receipt__meta-block">
          <span class="receipt__meta-label">Issued</span>
          <span class="receipt__meta-value" id="issued-date">Mar 03, 2026</span>
        </div>
        <div class="receipt__meta-block">
          <span class="receipt__meta-label">Billed to</span>
          <span class="receipt__meta-value">Claire Sherlock</span>
        </div>
        <div class="receipt__meta-block">
          <span class="receipt__meta-label">Status</span>
          <span class="receipt__meta-value" style="color: var(--garden-700)">✓ Paid</span>
        </div>
      </div>

      <table class="receipt__items">
        <thead>
          <tr>
            <th>Item</th>
            <th>Qty</th>
            <th>Amount</th>
          </tr>
        </thead>
        <tbody id="receipt-items">
          <tr>
            <td>
              <strong>Seasonal Camps 2026</strong>
              <span class="item-meta">For: Daisy · Mar 03 – May 28, 2026 · Studio Room A · Mon/Wed/Fri 5–7 PM</span>
              <span class="item-meta">Tracks: Dance, Theater, Gardening</span>
            </td>
            <td>1</td>
            <td>$250.00</td>
          </tr>
        </tbody>
      </table>

      <div class="receipt__totals">
        <div class="receipt__total-row"><span>Subtotal</span><span id="subtotal">$250.00</span></div>
        <div class="receipt__total-row"><span>Sibling discount</span><span style="color: var(--garden-700)">−$0.00</span></div>
        <div class="receipt__total-row"><span>Sales tax</span><span>$0.00</span></div>
        <div class="receipt__total-row receipt__total-row--grand"><strong>Total charged</strong><strong id="total">$250.00</strong></div>
      </div>

      <div class="receipt__payment">
        <i class="ph ph-credit-card"></i>
        <span>Paid with Mastercard ending in <strong>5555</strong> on Mar 03, 2026.</span>
      </div>

      <div class="receipt__notes">
        <p><strong>Tax-deductible portion:</strong> If this is a donation, the full amount may be tax-deductible to the extent allowed by law. Once Upon A Time, Inc. is a 501(c)(3) nonprofit (EIN: XX-XXXXXXX). No goods or services were provided in exchange for the contribution beyond the program enrollment listed above.</p>
        <p><strong>Refund policy:</strong> Full refunds available up to 14 days before the program start date. After that, partial credit may be applied to a future program. <a href="contact.html">Contact us</a> with questions.</p>
        <p><strong>Need help?</strong> Reply to your confirmation email or reach us at <a href="mailto:contact@onceuponatime.org">contact@onceuponatime.org</a> / +1-718-380-6929.</p>
      </div>

      <div class="receipt__footer">
        Thank you for supporting arts education in Queens.<br>
        Once Upon A Time, Inc. © 2026 — Receipt generated <span id="generated-time">automatically</span>
      </div>
    </article>

