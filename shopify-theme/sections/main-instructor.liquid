<section class="wrap" style="max-width:800px;padding:48px 24px">
      <a href="instructors.html" style="font-size:14px;color:var(--ink-muted);text-decoration:none;display:inline-flex;gap:6px;align-items:center;margin-bottom:16px"><i class="ph ph-arrow-left"></i> All instructors</a>
      <div style="display:grid;grid-template-columns:200px 1fr;gap:32px;align-items:start;margin-bottom:32px">
        <div id="instructor-photo" style="aspect-ratio:1;background:url('once-upon-a-time-assets/portraits/patricia.png') center top/cover;border-radius: var(--radius-md);filter:saturate(.9)"></div>
        <div>
          <p style="font-size:12px;font-weight:700;letter-spacing:.25em;color:var(--rose-700);text-transform:uppercase;margin-bottom:6px">Instructor</p>
          <h1 id="instructor-name" style="font-family:var(--serif);font-size:42px;margin:0 0 6px;text-transform:uppercase">Luna Pinelli</h1>
          <p id="instructor-role" style="font-size:15px;color:var(--rose-700);font-weight:600;margin:0 0 16px">Beginner Ballet · Jazz Dance</p>
          <p style="font-size:14px;color:var(--ink-muted);line-height:1.7;margin:0">A soloist with the NYC Ballet Workshop from 2018 to 2022, Luna teaches the next generation of dancers with the same precision she brought to the stage. Her classes focus on technical foundations — posture, alignment, footwork — paired with playful musicality.</p>
        </div>
      </div>
      <div style="background:var(--snow);border:1px solid var(--line);border-radius: var(--radius-md);padding:24px">
        <h2 style="font-family:var(--serif);font-size:20px;margin:0 0 16px;text-transform:uppercase">Currently teaching</h2>
        <ul style="list-style:none;padding:0;margin:0;display:grid;gap:12px">
          <li style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--line)"><div><div style="font-weight:600">Beginner Ballet (Ages 6–10)</div><div style="font-size:13px;color:var(--ink-muted)">Mon &amp; Wed · 4–5 PM · Studio A</div></div><a class="btn btn--sm" href="enrollment.html?class=ballet">Enroll</a></li>
          <li style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--line)"><div><div style="font-weight:600">Jazz Class — Winter 2026</div><div style="font-size:13px;color:var(--ink-muted)">Thu · 4 PM · Studio A · Ages 10+</div></div><a class="btn btn--sm" href="enrollment.html?class=jazz-winter-2026">Enroll</a></li>
        </ul>
      </div>
    </section>

