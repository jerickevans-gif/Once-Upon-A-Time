<section class='wrap' style='max-width:560px;padding:80px 24px;text-align:center'>
  <div style='display:inline-flex;width:80px;height:80px;border-radius:50%;background:var(--garden-100,#e8efd5);color:var(--garden-700);align-items:center;justify-content:center;font-size:36px;margin-bottom:18px'>
    <i class='ph ph-check-circle'></i>
  </div>
  <h1 style='font-family:var(--serif);font-size:38px;text-transform:uppercase;margin:0 0 12px;color:var(--pillar)'>
    You\'re unsubscribed
  </h1>
  <p style='color:var(--ink-muted);max-width:46ch;margin:0 auto 24px;line-height:1.6'>
    We\'ll stop sending you newsletter emails. Transactional messages (receipts, class confirmations) will still come
    through.
  </p>
  <p style='font-size:13px;color:var(--ink-muted);margin-bottom:24px'>
    Changed your mind? You can
    <a href='preferences.html' style='color:var(--rose-700);font-weight:600'>re-subscribe in preferences</a>.
  </p>
  <a class='btn btn--ghost' href='index.html'>Back to home</a>
</section>

{% schema %}
{
  "name": "Unsubscribe \u2014 Main",
  "tag": "section",
  "settings": []
}
{% endschema %}
