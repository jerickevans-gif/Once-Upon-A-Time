<style>
  @media (max-width: 540px) {
    .event-card {
      grid-template-columns: 1fr !important;
      text-align: center;
    }
    .event-card .btn {
      justify-self: center;
    }
  }
</style>

<section class='page-hero'>
  <div class='wrap'>
    <div class='page-hero__eyebrow'>What's coming up</div>
    <h1>Events &amp; Showcases</h1>
    <p class='page-hero__sub'>From end-of-season showcases to open studios and fundraising galas — see you there.</p>
  </div>
</section>
<section class='wrap' data-skeleton-list='5' style='padding:48px 0;display:grid;gap:18px;max-width:880px'>
  <article class='event-card'>
    <div style='text-align:center;padding:10px 0;background:var(--rose-100);border-radius: var(--radius);color:var(--rose-700)'>
      <div style='font-size:11px;font-weight:700;letter-spacing:.04em;text-transform:uppercase'>May</div>
      <div style='font-family:var(--serif);font-size:30px;font-weight:600;line-height:1'>28</div>
      <div style='font-size:11px;color:var(--ink-muted)'>2026</div>
    </div>
    <div>
      <h2 style='font-family:var(--serif);font-size:22px;margin:0 0 4px;text-transform:uppercase;color:var(--pillar)'>
        Spring Showcase 2026
      </h2>
      <p style='margin:0 0 8px;font-size:13px;color:var(--ink-muted)'>Sat May 28 · 6 PM · Studio A — 87-61 111th St</p>
      <p style='font-size:13px;line-height:1.55;margin:0'>
        End-of-season recital across all tracks. Free for families; donations welcome.
      </p>
    </div>
    <a
      class='btn btn--sm'
      href='#'
