<section class="page-hero">
      <div class="wrap"><div class="page-hero__eyebrow">For organizations</div>
      <h1>Corporate Sponsorship</h1>
      <p class="page-hero__sub">Reach a community of 1,500+ Queens families while underwriting transformative arts education. All sponsorships are tax-deductible.</p></div>
    </section>
    <section class="wrap" style="padding:48px 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;max-width:1100px">
      <article class="tier-card tier-card--friend"><div class="tier-card__label">Friend</div><div class="tier-card__price">$500</div><ul class="tier-card__features"><li>Logo on website donor wall</li><li>Annual impact report</li><li>Tax-deductible receipt</li></ul><a class="btn tier-card__cta" href="#sponsor-form" data-tier="Friend">Get in touch</a></article><article class="tier-card tier-card--partner"><div class="tier-card__label">Partner</div><div class="tier-card__price">$2,500</div><ul class="tier-card__features"><li>Everything in Friend, plus:</li><li>Logo at all in-studio events</li><li>2 tickets to Fall Gala</li><li>Quarterly impact dashboard</li></ul><a class="btn tier-card__cta" href="#sponsor-form" data-tier="Partner">Get in touch</a></article><article class="tier-card tier-card--champion"><div class="tier-card__label">Champion</div><div class="tier-card__price">$10,000</div><ul class="tier-card__features"><li>Everything in Partner, plus:</li><li>Named scholarship (1 student)</li><li>Studio space naming option</li><li>Table of 8 at Gala</li><li>Brand placement on showcase materials</li></ul><a class="btn tier-card__cta" href="#sponsor-form" data-tier="Champion">Get in touch</a></article><article class="tier-card tier-card--visionary"><div class="tier-card__label">Visionary</div><div class="tier-card__price">$25,000+</div><ul class="tier-card__features"><li>Everything in Champion, plus:</li><li>Named program track</li><li>Multi-year MOU available</li><li>Custom community engagement</li><li>Direct line to ED</li></ul><a class="btn tier-card__cta" href="#sponsor-form" data-tier="Visionary">Get in touch</a></article>
    </section>

    <!-- ============ SPONSORSHIP INQUIRY FORM ============ -->
    <section class="wrap" id="sponsor-form" style="max-width:780px;padding:24px 0 64px">
      <div style="background:var(--snow);border:1px solid var(--line);border-radius: var(--radius-md);padding:36px 36px 32px">
        <h2 style="font-family:var(--serif);font-size:28px;font-weight:600;text-transform:uppercase;color:var(--pillar);margin:0 0 8px">Tell us about your organization</h2>
        <p style="color:var(--ink-muted);font-size:14px;margin:0 0 24px">Our development director will follow up within 2 business days with a tailored proposal.</p>
        <!-- Replace REPLACE_ME with a Formspree form ID to submit real inquiries. -->
        <form id="sponsor-inquiry" novalidate data-formspree-id="REPLACE_ME" style="display:grid;gap:16px">
          <input type="hidden" name="form-source" value="sponsorship-page">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
            <label class="field"><span class="field__label">Organization*</span><input class="input" name="org" type="text" required aria-required="true"></label>
            <label class="field"><span class="field__label">Website</span><input class="input" name="website" type="url" placeholder="https://"></label>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
            <label class="field"><span class="field__label">Your name*</span><input class="input" name="contact-name" type="text" required aria-required="true"></label>
            <label class="field"><span class="field__label">Email*</span><input class="input" name="contact-email" type="email" required aria-required="true"></label>
          </div>
          <label class="field"><span class="field__label">Sponsorship tier of interest</span>
            <select class="input" name="tier" aria-label="Sponsorship tier">
              <option value="">Select a tier…</option>
              <option value="Friend">Friend ($500)</option>
              <option value="Partner">Partner ($2,500)</option>
              <option value="Champion">Champion ($10,000)</option>
              <option value="Visionary">Visionary ($25,000+)</option>
              <option value="Custom">Custom — let&#39;s discuss</option>
            </select>
          </label>
          <label class="field"><span class="field__label">Tell us about your goals</span>
            <textarea class="input" name="message" rows="5" style="padding:12px 14px;min-height:auto" placeholder="We&#39;d love to align our brand with arts education in Queens — what does the engagement timeline look like for the upcoming Fall Gala?"></textarea>
          </label>
          <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-top:6px">
            <p id="sponsor-status" role="status" aria-live="polite" class="sr-only" style="font-size:13px;margin:0"></p>
            <button class="btn" type="submit">Send inquiry <i class="ph ph-arrow-right"></i></button>
          </div>
        </form>
      </div>
    </section>

    <style>
      #sponsor-form .field__label { font-size: 13px; font-weight: 600; color: var(--ink); margin-bottom: 4px; display: block; }
      #sponsor-form .input { width: 100%; min-height: 44px; padding: 0 14px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--snow); font-size: var(--t-label); }
      #sponsor-form textarea.input { padding-top: 12px; }
      #sponsor-form .input:focus { outline: none; border-color: var(--rose); box-shadow: 0 0 0 3px var(--rose-100); }
      @media (max-width: 540px) {
        #sponsor-form div[style*="grid-template-columns"] { grid-template-columns: 1fr !important; }
      }
    </style>

    <script>
      (function () {
        // Tier links pre-fill the select
        document.querySelectorAll('a[data-tier]').forEach(a => {
          a.addEventListener('click', () => {
            const sel = document.querySelector('#sponsor-inquiry select[name="tier"]');
            if (sel) sel.value = a.dataset.tier;
          });
        });

        const form = document.getElementById('sponsor-inquiry');
        if (!form) return;
        const statusEl = document.getElementById('sponsor-status');

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          let bad = false;
          form.querySelectorAll('[required]').forEach(f => {
            if (!f.value.trim()) {
              const lbl = f.closest('.field')?.querySelector('.field__label')?.textContent?.replace('*','').trim() || 'This field';
              window.OUAT_setFieldError?.(f, lbl + ' is required');
              bad = true;
            } else if (f.type === 'email' && !/.+@.+\..+/.test(f.value)) {
              window.OUAT_setFieldError?.(f, 'Enter a valid email');
              bad = true;
            }
          });
          if (bad) return;

          const submitBtn = form.querySelector('button[type="submit"]');
          if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }
          const fid = form.dataset.formspreeId;
          if (!fid || fid === 'REPLACE_ME') {
            setTimeout(() => {
              window.OUAT_toast?.('Inquiry would send via Formspree in production. Set data-formspree-id on the form to enable real submission.', { variant:'mock', duration:4500 });
              if (statusEl) { statusEl.textContent = 'Inquiry sent (demo mode).'; statusEl.classList.remove('sr-only'); }
              if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = 'Send inquiry <i class="ph ph-arrow-right"></i>'; }
              form.reset();
            }, 600);
            return;
          }
          try {
            const data = new FormData(form);
            const res = await fetch(`https://formspree.io/f/${fid}`, { method:'POST', body:data, headers:{ Accept:'application/json' } });
            if (res.ok) {
              window.OUAT_toast?.('Thanks — your inquiry is in. Our development director will follow up within 2 business days.', { variant:'success', duration:4500 });
              if (statusEl) { statusEl.textContent = 'Thanks — your inquiry is on its way.'; statusEl.classList.remove('sr-only'); }
              form.reset();
            } else {
              window.OUAT_toast?.('Something went wrong. Try again, or email contact@onceuponatime.org.', { variant:'warning', duration:4500 });
            }
          } catch {
            window.OUAT_toast?.('Network error. Try again, or email contact@onceuponatime.org.', { variant:'warning' });
          } finally {
            if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = 'Send inquiry <i class="ph ph-arrow-right"></i>'; }
          }
        });
      })();
    </script>

{% schema %}
{
  "name": "Sponsorship \u2014 Main",
  "tag": "section",
  "settings": []
}
{% endschema %}
