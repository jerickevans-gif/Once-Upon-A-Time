<!-- ============ HERO ============ -->
<section class='pd-hero' role='img' aria-label='Students dancing in a seasonal camp performance'></section>

<!-- ============ BODY ============ -->
<section class='pd-body'>
  <div class='wrap pd-body__grid'>
    <!-- Sidebar -->
    <aside class='pd-side' aria-label='Page sections'>
      <details class='sidebar-collapse' open>
        <summary>Page Sections <i class='ph ph-caret-down' aria-hidden='true'></i></summary>
        <nav class='sidebar-collapse__nav pd-side__nav'>
          <a href='#program-info' class='is-active'>Program Info</a>
          <a href='#matching'>How We Match</a>
          <a href='#instructors'>Instructors</a>
          <a href='#class-location'>Class Location</a>
          <a href='#availability'>Availability</a>
          <a href='#faqs'>FAQs</a>
        </nav>
      </details>

      <div class='pd-capacity'>
        <div class='pd-capacity__top'>
          <div>
            <span class='pd-capacity__label'><i class='ph ph-info'></i> Class Capacity</span>
            <span class='pd-capacity__sub'>3 of 6 slots available</span>
          </div>
          <a
            class='btn'
            href='enrollment.html?class=private-lessons'
            data-register
            data-register-title='Private Lessons'
            data-register-schedule='By appointment | Weekdays 4–7pm | Ages 6+'
            data-register-seats='3 of 6'
            data-register-price='$75.00'
            data-register-action='enrollment.html?class=private-lessons'
            >Register now <i class='ph ph-arrow-right' aria-hidden='true'></i
          ></a>
        </div>
        <div class='pd-capacity__price-card'>
          <div class='pd-capacity__price'>$75.00</div>
          <p>Down payment required</p>
        </div>
      </div>
    </aside>

    <!-- Main content -->
    <article class='pd-main'>
      <h1>Private&nbsp;Lessons</h1>

      <!-- PROGRAM INFO -->
      <section class='pd-section' id='program-info' aria-labelledby='program-info-title'>
        <h2 id='program-info-title'>Program Info</h2>

        <div class='pd-sub'>
          <h3>Overview</h3>
          <p>
            One-on-one private lessons let students focus deeply on a single discipline at their own pace. Sessions are
            tailored to the student&rsquo;s goals — recital prep, audition coaching, foundational technique, or pure
            exploration. Each instructor builds a custom plan with the family at intake.
          </p>
        </div>

        <div class='pd-sub'>
          <h3>Class Schedule</h3>
          <p>Program Dates: <strong>Year-round (rolling enrollment)</strong></p>
          <p>By appointment &middot; weekdays 4&ndash;7PM</p>
          <p>Public Holiday: <strong>Studio holidays observed</strong></p>
        </div>

        <div class='pd-sub'>
          <h3>Eligibility</h3>
          <ul>
            <li>Ages 6+</li>
            <li>4-week minimum commitment</li>
          </ul>
        </div>

        <div class='pd-sub'>
          <h3>Program Components</h3>
          <ul class='pd-components'>
            <li>Ballet</li>
            <li>Voice</li>
            <li>Theater</li>
            <li>Jazz Dance</li>
            <li>Piano</li>
            <li>Visual Art</li>
          </ul>
        </div>

        <div class='pd-sub'>
          <h3>Pricing Tiers</h3>
          <table
            style='width:100%;border-collapse:collapse;font-size:var(--t-base)'
            aria-label='Lesson package pricing'
          >
            <thead>
              <tr style='font-weight:700;font-size:var(--t-label);text-align:left;border-bottom:2px solid var(--line)'>
                <th style='padding:var(--s-3) var(--s-4)'>Package</th>
                <th style='padding:var(--s-3) var(--s-4)'>Total</th>
                <th style='padding:var(--s-3) var(--s-4)'>Per Lesson</th>
              </tr>
            </thead>
            <tbody>
              <tr style='border-bottom:1px solid var(--line)'>
                <td style='padding:var(--s-3) var(--s-4)'>4 lessons</td>
                <td style='padding:var(--s-3) var(--s-4)'>$120</td>
                <td style='padding:var(--s-3) var(--s-4)'>$30</td>
              </tr>
              <tr style='border-bottom:1px solid var(--line)'>
                <td style='padding:var(--s-3) var(--s-4)'>8 lessons</td>
                <td style='padding:var(--s-3) var(--s-4)'>$216</td>
                <td style='padding:var(--s-3) var(--s-4)'>$27</td>
              </tr>
              <tr style='background:var(--garden-100)'>
                <td style='padding:var(--s-3) var(--s-4)'>12 lessons</td>
                <td style='padding:var(--s-3) var(--s-4)'>$288</td>
                <td style='padding:var(--s-3) var(--s-4)'>$24</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <hr class='pd-divider'>

      <!-- HOW WE MATCH YOU -->
      <section class='pd-section' id='matching' aria-labelledby='matching-title'>
        <h2 id='matching-title'>How We Match You</h2>
        <div class='pd-sub'>
          <p>We pair each student with an instructor based on three things:</p>
          <ol>
            <li><strong>Goals</strong> — recital prep, audition coaching, technique building, or exploration.</li>
            <li><strong>Learning style</strong> — we observe a trial session and talk with the family.</li>
            <li><strong>Schedule</strong> — we find overlapping availability so lessons stick.</li>
          </ol>
          <p>Not the right fit? Switching instructors mid-term is free and encouraged.</p>
        </div>
      </section>

      <hr class='pd-divider'>

      <!-- INSTRUCTORS -->
      <section class='pd-section' id='instructors' aria-labelledby='instructors-title'>
        <h2 id='instructors-title'>Instructors</h2>
        <div class='pd-instructors'>
          <article class='pd-instructor pd-instructor--courtney'>
            <div class='pd-instructor__photo' role='img' aria-label='Portrait of Courtney Diaz'></div>
            <h3>Courtney Diaz</h3>
            <p class='pd-instructor__role'>Dance Instructor</p>
            <p class='pd-instructor__bio'>
              Courtney is a dance instructor specialized in helping children develop strong foundations in movement. She
              creates a supportive learning environment where students can be their best and develop their dance moves.
            </p>
          </article>
          <article class='pd-instructor pd-instructor--darrell'>
            <div class='pd-instructor__photo' role='img' aria-label='Portrait of Darrell Yun'></div>
            <h3>Darrell Yun</h3>
            <p class='pd-instructor__role'>Music Instructor</p>
            <p class='pd-instructor__bio'>
              Darrell is a music instructor who shares an introduction to music, from rhythm to instruments. He provides
              hands-on activities where students build an understanding of music while offering instruments to play.
            </p>
          </article>
        </div>
      </section>

      <hr class='pd-divider'>

      <!-- CLASS LOCATIONS -->
      <section class='pd-section' id='class-location' aria-labelledby='locations-title'>
        <h2 id='locations-title'>Class Locations</h2>
        <div class='pd-locations'>
          <div class='pd-location-list'>
            <div class='pd-sub'>
              <h3>Drop-Off &amp; Pickup</h3>
              <p>
                Drop off and pickup can get busy &mdash; we recommend arriving early. If needed, one of us can help with
                picking up your child. Just let us know.
              </p>
            </div>
            <div class='pd-sub'>
              <h3>Address</h3>
              <p>158-40 76th Rd, Fresh Meadows, NY 11366, United States</p>
            </div>
            <div class='pd-sub'>
              <h3>Contact</h3>
              <p>+1 718-380-6929</p>
            </div>
          </div>
          <div class='pd-map' aria-label='Map showing class location at 158-40 76th Rd, Fresh Meadows, NY'>
            <iframe
              class='pd-map__frame'
              src='https://www.google.com/maps?q=158-40+76th+Rd+Fresh+Meadows+NY+11366&output=embed'
              title='Class location map — 158-40 76th Rd, Fresh Meadows, NY'
              loading='lazy'
              referrerpolicy='no-referrer-when-downgrade'
            ></iframe>
          </div>
        </div>
      </section>

      <hr class='pd-divider'>

      <!-- AVAILABILITY -->
      <section class='pd-section' id='availability' aria-labelledby='avail-title'>
        <h2 id='avail-title'>Available Slots This Week</h2>
        <div class='pd-sub'>
          <table
            style='width:100%;border-collapse:collapse;font-size:var(--t-label);text-align:center'
            aria-label='Weekly availability grid'
          >
            <thead>
              <tr style='font-weight:700;color:var(--ink-muted);border-bottom:2px solid var(--line)'>
                <th style='padding:var(--s-2)'></th>
                <th style='padding:var(--s-2)'>Mon</th>
                <th style='padding:var(--s-2)'>Tue</th>
                <th style='padding:var(--s-2)'>Wed</th>
                <th style='padding:var(--s-2)'>Thu</th>
                <th style='padding:var(--s-2)'>Fri</th>
              </tr>
            </thead>
            <tbody>
              <tr style='border-bottom:1px solid var(--line)'>
                <td style='padding:var(--s-2);font-weight:600;color:var(--ink-muted)'>4 PM</td>
                <td style='padding:var(--s-2);color:var(--garden-700);font-weight:600'>Open</td>
                <td style='padding:var(--s-2);color:var(--ink-muted)'>Booked</td>
                <td style='padding:var(--s-2);color:var(--garden-700);font-weight:600'>Open</td>
                <td style='padding:var(--s-2);color:var(--ink-muted)'>Booked</td>
                <td style='padding:var(--s-2);color:var(--garden-700);font-weight:600'>Open</td>
              </tr>
              <tr style='border-bottom:1px solid var(--line)'>
                <td style='padding:var(--s-2);font-weight:600;color:var(--ink-muted)'>5 PM</td>
                <td style='padding:var(--s-2);color:var(--ink-muted)'>Booked</td>
                <td style='padding:var(--s-2);color:var(--garden-700);font-weight:600'>Open</td>
                <td style='padding:var(--s-2);color:var(--ink-muted)'>Booked</td>
                <td style='padding:var(--s-2);color:var(--garden-700);font-weight:600'>Open</td>
                <td style='padding:var(--s-2);color:var(--ink-muted)'>Booked</td>
              </tr>
              <tr>
                <td style='padding:var(--s-2);font-weight:600;color:var(--ink-muted)'>6 PM</td>
                <td style='padding:var(--s-2);color:var(--garden-700);font-weight:600'>Open</td>
                <td style='padding:var(--s-2);color:var(--garden-700);font-weight:600'>Open</td>
                <td style='padding:var(--s-2);color:var(--ink-muted)'>Booked</td>
                <td style='padding:var(--s-2);color:var(--garden-700);font-weight:600'>Open</td>
                <td style='padding:var(--s-2);color:var(--garden-700);font-weight:600'>Open</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <hr class='pd-divider'>

      <!-- FAQs -->
      <section class='pd-section' id='faqs' aria-labelledby='faqs-title'>
        <h2 id='faqs-title'>FAQs</h2>
        <details class='pd-sub'>
          <summary><strong>What should my child bring to camp?</strong></summary>
          <p>Comfortable clothing, a refillable water bottle, and a packed snack. We provide all program materials.</p>
        </details>
        <details class='pd-sub'>
          <summary><strong>Are scholarships available?</strong></summary>
          <p>
            Yes &mdash; partial and full scholarships are awarded on a rolling basis. Email
            <a href='mailto:contact@onceuponatime.org'>contact@onceuponatime.org</a> for the application.
          </p>
        </details>
        <details class='pd-sub'>
          <summary><strong>Can I drop in for a single session?</strong></summary>
          <p>
            Our seasonal camps require a 2-month commitment so students can build through the full arc, but private
            sessions are available for short-term enrollment.
          </p>
        </details>
      </section>

      <!-- Still have questions -->
      <div class='pd-help'>
        <div>
          <h2>Still Have Questions?</h2>
          <p>Please write to our friendly support team or call us at <strong>+1 123-456-789</strong>.</p>
        </div>
        <a class='btn btn--outline' href='contact.html'>Send Email</a>
      </div>
    </article>
  </div>
</section>

<!-- ============ ALTERNATIVES ============ -->
<section class='pd-alts' aria-labelledby='alts-title'>
  <div class='wrap'>
    <h2 id='alts-title'>Not what you&rsquo;re looking for?</h2>
    <div class='pd-alts__grid'>
      <article class='pd-alt'>
        <h3>Seasonal Camps</h3>
        <p>
          Seasonal camps offer programs that combine dance, acting, and art activities. In this space, children can
          explore their creativity, build confidence, and connect with classmates through collaborative lessons.
        </p>
        <a class='btn btn--outline btn--sm' href='seasonal-camps.html'>View Details</a>
      </article>
      <article class='pd-alt'>
        <h3>Create Your Own Path</h3>
        <p>
          This option lets students design their own learning journey across dance, music, art, and theater. Through
          hands-on activities, children can explore multiple creative styles at their own pace to discover what they
          love most.
        </p>
        <a class='btn btn--outline btn--sm' href='contact.html'>View Details</a>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Private Lessons \u2014 Main",
  "tag": "section",
  "settings": []
}
{% endschema %}
