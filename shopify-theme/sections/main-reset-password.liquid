<section class="wrap" style="max-width:480px;padding:80px 24px">
      <h1 style="font-family:var(--serif);font-size:42px;text-transform:uppercase;margin:0 0 8px;color:var(--rose-700)">Set a new password</h1>
      <p style="color:var(--ink-muted);margin:0 0 32px">Choose a password you haven\'t used before. Minimum 12 characters.</p>
      <form id="reset-form" novalidate>
        <label class="field" style="display:flex;flex-direction:column;gap:6px;margin-bottom:18px"><span style="font-size:14px;font-weight:500">New password</span>
          <input class="input" id="np" type="password" required minlength="12" autocomplete="new-password" style="min-height:44px;padding:0 16px;border:1px solid var(--line);border-radius:8px;background:var(--snow);font-size:14px">
        </label>
        <label class="field" style="display:flex;flex-direction:column;gap:6px"><span style="font-size:14px;font-weight:500">Confirm new password</span>
          <input class="input" id="np2" type="password" required minlength="12" autocomplete="new-password" style="min-height:44px;padding:0 16px;border:1px solid var(--line);border-radius:8px;background:var(--snow);font-size:14px">
        </label>
        <ul style="margin-top:16px;font-size:12px;color:var(--ink-muted);padding-left:20px">
          <li id="rp-len">At least 12 characters</li><li id="rp-num">Contains a number</li><li id="rp-match">Passwords match</li>
        </ul>
        <button class="btn" type="submit" style="width:100%;margin-top:24px">Update password</button>
      </form>
    </section>
    <script>
      const np = document.getElementById('np'), np2 = document.getElementById('np2');
      const len = document.getElementById('rp-len'), num = document.getElementById('rp-num'), match = document.getElementById('rp-match');
      function check () {
        const v = np.value;
        len.style.color = v.length >= 12 ? 'var(--garden-700)' : 'var(--ink-muted)';
        num.style.color = /\\d/.test(v) ? 'var(--garden-700)' : 'var(--ink-muted)';
        match.style.color = (v && v === np2.value) ? 'var(--garden-700)' : 'var(--ink-muted)';
      }
      np.addEventListener('input', check); np2.addEventListener('input', check);
      document.getElementById('reset-form').addEventListener('submit', e => {
        e.preventDefault();
        if (window.OUAT_toast) window.OUAT_toast('Password updated. Sign in to continue. (Routes to Shopify customer accounts in production.)', { variant: 'success', duration: 4000 });
        setTimeout(() => location.href = 'login.html', 2000);
      });
    </script>

{% schema %}
{
  "name": "Reset Password \u2014 Main",
  "tag": "section",
  "settings": []
}
{% endschema %}
