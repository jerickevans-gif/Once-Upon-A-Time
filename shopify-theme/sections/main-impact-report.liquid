<style>
  @media (max-width: 540px) {
    .impact-stats-grid {
      grid-template-columns: 1fr 1fr !important;
    }
    .impact-stories-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<section class='page-hero' style='background:linear-gradient(180deg,var(--rose-100),var(--beginning))'>
  <div class='wrap'>
    <div class='page-hero__eyebrow'>2025 Annual Report</div>
    <h1>Where Your Donation Went</h1>
    <p class='page-hero__sub'>
      Transparency is the foundation of trust. Here's exactly how 2025 dollars served our community.
    </p>
  </div>
</section>

<section
  class='wrap impact-stats-grid'
  style='padding:48px 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:18px;max-width:1100px'
>
  <div class='stat-card'>
    <div class='stat-card__num'>$2.1M</div>
    <div class='stat-card__label'>Funds raised</div>
  </div>
  <div class='stat-card'>
    <div class='stat-card__num'>162</div>
    <div class='stat-card__label'>Children served</div>
  </div>
  <div class='stat-card'>
    <div class='stat-card__num'>11</div>
    <div class='stat-card__label'>Programs offered</div>
  </div>
  <div class='stat-card'>
    <div class='stat-card__num'>48</div>
    <div class='stat-card__label'>Scholarships awarded</div>
  </div>
  <div class='stat-card'>
    <div class='stat-card__num'>8,200</div>
    <div class='stat-card__label'>Class hours taught</div>
  </div>
  <div class='stat-card'>
    <div class='stat-card__num'>27</div>
    <div class='stat-card__label'>Volunteer hours per week</div>
  </div>
</section>

<section class='wrap' style='padding:48px 0;max-width:880px'>
  <h2 style='font-family:var(--serif);font-size:32px;text-transform:uppercase;margin-bottom:20px;color:var(--pillar)'>
    How dollars were spent
  </h2>
  <div style='background:var(--snow);border:1px solid var(--line);border-radius: var(--radius-md);padding:32px'>
    <div style='display:grid;gap:14px'>
      <div>
        <div style='display:flex;justify-content:space-between;font-size:14px;margin-bottom:6px'>
          <span style='font-weight:600'>Direct program costs (instructors, materials)</span
          ><span style='color:var(--ink-muted)'>68% — $1428k</span>
        </div>
        <div style='height:8px;background:var(--rose-50);border-radius:999px;overflow:hidden'>
          <div style='height:100%;width:68%;background:var(--rose);border-radius:999px'></div>
        </div>
      </div>
      <div>
        <div style='display:flex;justify-content:space-between;font-size:14px;margin-bottom:6px'>
          <span style='font-weight:600'>Scholarships</span><span style='color:var(--ink-muted)'>12% — $252k</span>
        </div>
        <div style='height:8px;background:var(--rose-50);border-radius:999px;overflow:hidden'>
          <div style='height:100%;width:12%;background:var(--garden);border-radius:999px'></div>
        </div>
      </div>
      <div>
        <div style='display:flex;justify-content:space-between;font-size:14px;margin-bottom:6px'>
          <span style='font-weight:600'>Studio space &amp; utilities</span
          ><span style='color:var(--ink-muted)'>9% — $189k</span>
        </div>
        <div style='height:8px;background:var(--rose-50);border-radius:999px;overflow:hidden'>
          <div style='height:100%;width:9%;background:var(--blush);border-radius:999px'></div>
        </div>
      </div>
      <div>
        <div style='display:flex;justify-content:space-between;font-size:14px;margin-bottom:6px'>
          <span style='font-weight:600'>Administrative</span><span style='color:var(--ink-muted)'>7% — $147k</span>
        </div>
        <div style='height:8px;background:var(--rose-50);border-radius:999px;overflow:hidden'>
          <div style='height:100%;width:7%;background:var(--pillar);border-radius:999px'></div>
        </div>
      </div>
      <div>
        <div style='display:flex;justify-content:space-between;font-size:14px;margin-bottom:6px'>
          <span style='font-weight:600'>Fundraising</span><span style='color:var(--ink-muted)'>4% — $84k</span>
        </div>
        <div style='height:8px;background:var(--rose-50);border-radius:999px;overflow:hidden'>
          <div style='height:100%;width:4%;background:var(--rose-300);border-radius:999px'></div>
        </div>
      </div>
    </div>
    <p style='font-size:12px;color:var(--ink-muted);margin-top:20px'>
      Source: 2025 Form 990. Audited financials available on request.
    </p>
  </div>
</section>

<section class='wrap' style='padding:48px 0;max-width:880px'>
  <h2 style='font-family:var(--serif);font-size:32px;text-transform:uppercase;margin-bottom:20px;color:var(--pillar)'>
    Stories from this year
  </h2>
  <div
    class='impact-stories-grid'
    style='display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px'
  >
    <div style='background:var(--rose-50);border-radius: var(--radius-md);padding:24px'>
      <div style='font-family:var(--serif);font-size:20px;color:var(--rose-700);margin-bottom:8px'>
        Our community garden grew 480 lbs of produce
      </div>
      <p style='font-size:13px;color:var(--ink-muted);line-height:1.6;margin:0'>
        Donated to families and the local food pantry.
      </p>
    </div>
    <div style='background:var(--rose-50);border-radius: var(--radius-md);padding:24px'>
      <div style='font-family:var(--serif);font-size:20px;color:var(--rose-700);margin-bottom:8px'>
        48 scholarships awarded
      </div>
      <p style='font-size:13px;color:var(--ink-muted);line-height:1.6;margin:0'>
        Up from 31 last year. Every applying family with documented need received support.
      </p>
    </div>
    <div style='background:var(--rose-50);border-radius: var(--radius-md);padding:24px'>
      <div style='font-family:var(--serif);font-size:20px;color:var(--rose-700);margin-bottom:8px'>
        200+ family members at end-of-year showcase
      </div>
      <p style='font-size:13px;color:var(--ink-muted);line-height:1.6;margin:0'>
        Our largest audience to date — and our students rose to meet it.
      </p>
    </div>
  </div>
</section>

<section class='wrap' style='padding:48px 0 80px;text-align:center'>
  <h2 style='font-family:var(--serif);font-size:32px;text-transform:uppercase;margin-bottom:12px;color:var(--pillar)'>
    Help us grow in 2026
  </h2>
  <p style='color:var(--ink-muted);max-width:50ch;margin:0 auto 20px'>
    Our goal is 200 children served and 60 scholarships awarded.
  </p>
  <a class='btn' href='donate.html'>Make a donation <i class='ph ph-arrow-right'></i></a>
</section>

{% schema %}
{
  "name": "Impact Report \u2014 Main",
  "tag": "section",
  "settings": []
}
{% endschema %}
