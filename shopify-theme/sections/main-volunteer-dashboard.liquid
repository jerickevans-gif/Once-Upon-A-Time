<section class='page-hero'>
  <div class='wrap'>
    <div class='page-hero__eyebrow'>Get involved</div>
    <h1>Volunteer With Us</h1>
    <p class='page-hero__sub'>
      Mentor a student. Help run an event. Garden with us on Saturdays. Find a way to plug in below.
    </p>
  </div>
</section>
<section class='wrap' style='padding:48px 0;display:grid;grid-template-columns:1.4fr 1fr;gap:32px;max-width:1100px'>
  <div>
    <h2 style='font-family:var(--serif);font-size:24px;text-transform:uppercase;margin-bottom:16px;color:var(--pillar)'>
      Open shifts
    </h2>
    <div style='display:grid;gap:12px'>
      <article style='background:var(--snow);border:1px solid var(--line);border-radius:12px;padding:18px 22px;display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center'>
        <div>
          <div style='font-weight:700;font-size:15px'>Spring Showcase Setup</div>
          <div style='font-size:12px;color:var(--ink-muted);margin-top:4px'>Sat May 28 · 2–6 PM · Studio A</div>
          <div style='font-size:13px;margin-top:6px;line-height:1.5'>
            Stage setup, lighting checks, refreshment table.
          </div>
        </div>
        <button
          class='btn btn--sm'
          type='button'
          data-mock='signup-shift'
          data-mock-toast='Shift sign-up routes to Shopify customer metaobject in production.'
        >
          Sign up
        </button>
      </article>
      <article style='background:var(--snow);border:1px solid var(--line);border-radius:12px;padding:18px 22px;display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center'>
        <div>
          <div style='font-weight:700;font-size:15px'>Garden Saturday</div>
          <div style='font-size:12px;color:var(--ink-muted);margin-top:4px'>
            Every Sat · 10 AM–1 PM · Queens Botanical Garden
          </div>
          <div style='font-size:13px;margin-top:6px;line-height:1.5'>Helps lead 8–12 year olds through plant care.</div>
        </div>
        <button
          class='btn btn--sm'
          type='button'
          data-mock='signup-shift'
          data-mock-toast='Shift sign-up routes to Shopify customer metaobject in production.'
        >
          Sign up
        </button>
      </article>
      <article style='background:var(--snow);border:1px solid var(--line);border-radius:12px;padding:18px 22px;display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center'>
        <div>
          <div style='font-weight:700;font-size:15px'>Fall Gala Reception</div>
          <div style='font-size:12px;color:var(--ink-muted);margin-top:4px'>Sat Sep 20 · 6–11 PM · TBA</div>
          <div style='font-size:13px;margin-top:6px;line-height:1.5'>
            Greet guests, manage check-in, run silent auction.
          </div>
        </div>
        <button
          class='btn btn--sm'
          type='button'
          data-mock='signup-shift'
          data-mock-toast='Shift sign-up routes to Shopify customer metaobject in production.'
        >
          Sign up
        </button>
      </article>
      <article style='background:var(--snow);border:1px solid var(--line);border-radius:12px;padding:18px 22px;display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center'>
        <div>
          <div style='font-weight:700;font-size:15px'>Class Photographer</div>
          <div style='font-size:12px;color:var(--ink-muted);margin-top:4px'>Per session · Studios</div>
          <div style='font-size:13px;margin-top:6px;line-height:1.5'>
            Photograph weekly classes for our gallery + newsletter.
          </div>
        </div>
        <button
          class='btn btn--sm'
          type='button'
          data-mock='signup-shift'
          data-mock-toast='Shift sign-up routes to Shopify customer metaobject in production.'
        >
          Sign up
        </button>
      </article>
    </div>
  </div>
  <aside>
    <div style='background:var(--rose-100);border-radius: var(--radius-md);padding:24px;margin-bottom:18px'>
      <div style='font-size:11px;font-weight:700;letter-spacing:.25em;color:var(--rose-700);text-transform:uppercase;margin-bottom:8px'>
        Your impact
      </div>
      <div style='font-family:var(--serif);font-size:42px;font-weight:600;color:var(--pillar);line-height:1'>
        36 <span style='font-size:16px;color:var(--ink-muted)'>hours</span>
      </div>
      <p style='font-size:13px;color:var(--ink-muted);margin:8px 0 0'>Logged this year. Thank you, Claire.</p>
    </div>
    <div style='background:var(--snow);border:1px solid var(--line);border-radius: var(--radius-md);padding:24px'>
      <h3 style='font-family:var(--serif);font-size:18px;text-transform:uppercase;margin:0 0 10px'>New here?</h3>
      <p style='font-size:13px;color:var(--ink-muted);line-height:1.6;margin:0 0 14px'>
        Volunteers complete a short orientation and background check before their first shift.
      </p>
      <a class='btn btn--sm' href='mailto:contact@onceuponatime.org?subject=Volunteer%20interest'>Start onboarding</a>
    </div>
  </aside>
</section>

{% schema %}
{
  "name": "Volunteer Dashboard \u2014 Main",
  "tag": "section",
  "settings": []
}
{% endschema %}
