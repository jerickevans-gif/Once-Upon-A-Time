<style>
  /* ===== Page title ===== */
  .nl-title {
    padding: var(--s-7) 0 var(--s-3);
  }
  .nl-title h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(40px, 5.4vw, 72px);
    text-transform: uppercase;
    margin: 0;
    line-height: var(--lh-display);
    letter-spacing: 0.02em;
  }

  /* ===== Toolbar ===== */
  .nl-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    flex-wrap: wrap;
    padding: var(--s-3) 0 var(--s-6);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--s-6);
  }
  .nl-tabs {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    flex-wrap: wrap;
  }
  .nl-tabs a {
    font-size: var(--t-label);
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    padding: 6px 0;
    border-bottom: 2px solid transparent;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .nl-tabs a.is-active {
    border-bottom-color: var(--rose-700);
    color: var(--rose-700);
  }
  .nl-tabs a:hover {
    color: var(--rose);
  }
  .nl-tabs a.is-muted {
    color: var(--ink-muted);
  }
  .nl-tabs__badge {
    background: var(--rose);
    color: var(--snow);
    font-size: 11px;
    font-weight: 700;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .nl-tabs__more-wrap {
    position: relative;
    display: inline-flex;
  }
  .nl-tabs__more {
    background: transparent;
    border: 0;
    padding: 4px 8px;
    color: var(--ink);
    font-size: 18px;
    cursor: pointer;
    letter-spacing: 2px;
    line-height: 1;
  }
  /* Accessibility dropdown — Figma 3 Dot Menu_Newsletter (2748:45003). */
  .nl-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 225px;
    background: #735041; /* Figma rgb(.45, .26, .22) */
    color: var(--snow);
    border-radius: var(--radius-lg);
    padding: var(--s-4) var(--s-5);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);
    z-index: 50;
    list-style: none;
    margin: 0;
  }
  .nl-dropdown[hidden] {
    display: none;
  }
  .nl-dropdown li {
    padding: var(--s-3) 0;
    border-bottom: 1px solid rgba(255, 252, 250, 0.25);
  }
  .nl-dropdown li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .nl-dropdown li:first-child {
    padding-top: 0;
  }
  .nl-dropdown button {
    background: transparent;
    border: 0;
    padding: 0;
    color: var(--snow);
    font-family: var(--sans);
    font-size: var(--t-md);
    font-weight: 500;
    width: 100%;
    text-align: left;
    cursor: pointer;
    line-height: 1.4;
  }
  .nl-dropdown button:hover {
    color: var(--rose-100);
  }
  .nl-tools {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    flex-wrap: wrap;
  }
  .nl-panel[hidden] {
    display: none !important;
  }
  .nl-involved-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--s-5);
    margin-top: var(--s-5);
  }
  .nl-involved-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-6);
    background: var(--snow);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s,
      box-shadow 0.2s;
  }
  .nl-involved-card:hover {
    border-color: var(--rose-300);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(139, 80, 68, 0.08);
  }
  .nl-involved-card > i.ph {
    font-size: 32px;
    color: var(--rose);
  }
  .nl-involved-card h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 22px;
    margin: 0;
  }
  .nl-involved-card p {
    color: var(--ink-muted);
    font-size: 14px;
    margin: 0;
    line-height: 1.55;
  }
  .nl-involved-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    color: var(--rose-700);
    margin-top: auto;
  }
  .nl-filter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--snow);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm, 8px);
    padding: 8px 14px;
    font-size: var(--t-label);
    color: var(--ink-muted);
    cursor: pointer;
  }
  .nl-filter:hover {
    border-color: var(--rose);
    color: var(--rose-700);
  }
  .nl-filter .ph {
    font-size: 14px;
  }
  .nl-search {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--snow);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm, 8px);
    padding: 4px 12px 4px 14px;
    min-width: 220px;
  }
  .nl-search .ph {
    color: var(--ink-muted);
    font-size: 14px;
  }
  .nl-search input {
    border: 0;
    background: transparent;
    outline: 0;
    font-size: var(--t-label);
    color: var(--ink);
    flex: 1;
    padding: 8px 0;
    min-width: 0;
  }
  .nl-search input::placeholder {
    color: var(--ink-muted);
  }

  /* Current Newsletter heading row + action buttons */
  /* ===== Featured Story + More Stories (Figma 2748:44028 WIP redesign) ===== */
  .nl-section-eyebrow {
    font-size: var(--t-md);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 var(--s-4);
  }
  .nl-featured {
    padding-top: var(--s-3);
    padding-bottom: var(--s-6);
  }
  /* Figma "Newsletter Card v2_dropshadow" (2748:44915):
       fill #FFF5EE (--beginning), r=14. Shadow only on hover. */
  .nl-featured-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    background: var(--beginning);
    border-radius: 14px;
    overflow: hidden;
    align-items: stretch;
    transition: box-shadow 0.25s ease;
  }
  .nl-featured-card:hover,
  .nl-featured-card:focus-within {
    box-shadow:
      0 4px 6px 0 rgba(166, 109, 98, 0.35),
      0 4px 4px 0 rgba(0, 0, 0, 0.18);
  }
  .nl-featured-card__copy {
    padding: var(--s-7) var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .nl-featured-card__brand {
    display: inline-flex;
    gap: var(--s-2);
    align-items: center;
    font-size: var(--t-label);
    font-weight: 600;
    color: var(--rose-700);
    letter-spacing: 0.04em;
    margin: 0;
  }
  .nl-featured-card__pipe {
    color: var(--rose-300);
    font-weight: 400;
  }
  .nl-featured-card__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(28px, 3.4vw, 40px);
    color: var(--rose-700);
    text-transform: none;
    margin: 0;
    line-height: 1.1;
  }
  .nl-featured-card__body {
    font-size: var(--t-base);
    color: var(--ink);
    line-height: var(--lh-body);
    margin: 0;
  }
  .nl-featured-card__actions {
    display: flex;
    gap: var(--s-2);
    flex-wrap: wrap;
    margin-top: var(--s-3);
  }
  .nl-featured-card__photo {
    background:
      linear-gradient(rgba(139, 80, 68, 0.32), rgba(139, 80, 68, 0.42)),
      url('once-upon-a-time-assets/landing/jazz-hero.jpg') center/cover no-repeat;
    min-height: 360px;
  }
  @media (max-width: 900px) {
    .nl-featured-card {
      grid-template-columns: 1fr;
    }
    .nl-featured-card__photo {
      min-height: 240px;
    }
    .nl-featured-card__copy {
      padding: var(--s-5);
    }
  }

  .nl-stories {
    padding-top: var(--s-7);
    padding-bottom: var(--s-8);
  }
  .nl-stories__heading {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(28px, 3.4vw, 44px);
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 var(--s-5);
  }
  .nl-stories__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-6);
  }
  @media (max-width: 720px) {
    .nl-stories__grid {
      grid-template-columns: 1fr;
    }
  }
  .nl-story-card {
    background: var(--beginning);
    border-radius: 14px; /* matches Newsletter Card v2_dropshadow */
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.25s ease;
  }
  .nl-story-card:hover,
  .nl-story-card:focus-within {
    box-shadow:
      0 4px 6px 0 rgba(166, 109, 98, 0.35),
      0 4px 4px 0 rgba(0, 0, 0, 0.18);
  }
  .nl-story-card__photo {
    aspect-ratio: 16/9;
    background-size: cover;
    background-position: center;
    background-color: var(--rose-300);
  }
  .nl-story-card__photo--oct {
    background-image:
      linear-gradient(rgba(107, 109, 32, 0.3), rgba(107, 109, 32, 0.42)),
      url('once-upon-a-time-assets/landing/queens-skyline.jpg');
  }
  .nl-story-card__photo--nov {
    background-image:
      linear-gradient(rgba(139, 80, 68, 0.3), rgba(139, 80, 68, 0.45)),
      url('once-upon-a-time-assets/landing/jazz-hero.jpg');
  }
  .nl-story-card__body {
    padding: var(--s-5) var(--s-5) var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    flex: 1;
  }
  .nl-story-card__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: var(--t-h4);
    color: var(--rose-700);
    text-transform: none;
    margin: 0;
    line-height: 1.15;
  }
  .nl-story-card__meta {
    font-size: var(--t-label);
    color: var(--ink-muted);
    margin: 0;
  }
  .nl-story-card__copy {
    font-size: var(--t-base);
    color: var(--ink);
    line-height: var(--lh-body);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .nl-story-card__actions {
    display: flex;
    gap: var(--s-2);
    flex-wrap: wrap;
    margin-top: auto;
  }

  .nl-current-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    flex-wrap: wrap;
    margin-bottom: var(--s-5);
  }
  .nl-current-head h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(28px, 3vw, 40px);
    text-transform: uppercase;
    margin: 0;
    letter-spacing: 0.02em;
  }
  .nl-actions {
    display: inline-flex;
    gap: 8px;
  }
  .nl-action {
    width: 38px;
    height: 38px;
    border: 0;
    cursor: pointer;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--rose-700);
    color: var(--snow);
    font-size: 16px;
  }
  .nl-action--share {
    background: var(--garden);
  }
  .nl-action:hover {
    filter: brightness(1.08);
  }

  /* Article card-level bookmark/share floating in feature top-right */
  .nl-feature {
    position: relative;
  }
  .nl-feature__actions {
    position: absolute;
    top: 0;
    right: 0;
    display: inline-flex;
    gap: 6px;
    padding: 12px;
  }
  .nl-feature__actions .nl-action {
    width: 32px;
    height: 32px;
    font-size: 14px;
  }

  /* ===== Eyebrow row ===== */
  .nl-eyebrow {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-4);
    flex-wrap: wrap;
  }
  .nl-eyebrow .eyebrow {
    margin: 0;
  }
  .nl-tag {
    display: inline-flex;
    align-items: center;
    background: var(--snow);
    border: 1px solid var(--line);
    color: var(--ink);
    font-size: var(--t-micro);
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    font-weight: 600;
  }
  .nl-chips {
    display: inline-flex;
    gap: 6px;
    margin-left: auto;
  }
  .nl-chip {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    color: var(--snow);
  }
  .nl-chip--rose {
    background: var(--rose);
  }
  .nl-chip--garden {
    background: var(--garden);
  }
  .nl-chip--blush {
    background: var(--blush);
    color: var(--rose-700);
  }
  .nl-chip--pillar {
    background: var(--pillar);
  }
  .nl-chip--sky {
    background: var(--sky);
    color: var(--ink);
  }
  .nl-chip--snow {
    background: var(--snow);
    border: 1px solid var(--line);
    color: var(--ink);
  }
  .nl-feature__date {
    font-family: var(--serif);
    font-size: var(--t-h4);
    font-weight: 400;
    color: var(--rose-700);
    margin: 0 0 var(--s-2);
  }

  /* ===== Featured article (lead) ===== */
  .nl-feature {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--s-7);
    align-items: start;
    margin-bottom: var(--s-8);
  }
  .nl-feature__head {
    grid-column: 1 / -1;
    margin-bottom: var(--s-4);
  }
  .nl-feature h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(34px, 4vw, 52px);
    text-transform: uppercase;
    margin: 0 0 var(--s-2);
    letter-spacing: 0.02em;
  }
  .nl-byline {
    font-size: var(--t-label);
    color: var(--ink-muted);
    margin: 0;
    letter-spacing: 0.01em;
  }
  .nl-byline .pipe {
    display: inline-block;
    padding: 0 8px;
    opacity: 0.55;
  }
  .nl-feature__body {
    column-count: 2;
    column-gap: var(--s-6);
    font-size: var(--t-base);
    color: var(--ink);
    line-height: 1.7;
    hyphens: auto;
  }
  .nl-feature__body p {
    margin: 0 0 var(--s-3);
    break-inside: avoid-column;
  }
  .nl-feature__body p:first-child::first-letter {
    font-family: var(--serif);
    font-weight: 400;
    float: left;
    font-size: 56px;
    line-height: 0.9;
    padding: 4px 8px 0 0;
    color: var(--rose-700);
  }
  .nl-feature__photo {
    aspect-ratio: 4/5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: url('once-upon-a-time-assets/newsletter/feature-women-dancing.jpg?v=2') center/cover no-repeat;
  }

  /* ===== Sub-articles ===== */
  .nl-article {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--s-6);
    align-items: start;
    padding: var(--s-6) 0;
    border-top: 1px solid var(--line);
  }
  .nl-article--reverse {
    grid-template-columns: 1.2fr 1fr;
  }
  .nl-article--reverse .nl-article__photo {
    order: 2;
  }
  .nl-article__photo {
    aspect-ratio: 4/3;
    border-radius: var(--radius);
    overflow: hidden;
    background-size: cover;
    background-position: center;
  }
  .nl-article--garden .nl-article__photo {
    background: url('once-upon-a-time-assets/newsletter/garden-watering-can.jpg?v=2') center/cover no-repeat;
  }
  .nl-article--update .nl-article__photo {
    background: url('once-upon-a-time-assets/newsletter/garden-update-field.jpg?v=2') center/cover no-repeat;
  }
  .nl-article--volunteer .nl-article__photo {
    background: url('once-upon-a-time-assets/newsletter/volunteer-pepsi-sign.jpg?v=2') center/cover no-repeat;
  }
  .nl-article h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(28px, 2.8vw, 36px);
    text-transform: uppercase;
    margin: 0 0 var(--s-2);
    letter-spacing: 0.02em;
  }
  .nl-article__body {
    font-size: var(--t-label);
    color: var(--ink);
    line-height: var(--lh-body);
  }
  .nl-article__body p {
    margin: 0 0 var(--s-3);
  }

  /* ===== Related newsletters ===== */
  .nl-related {
    padding: var(--s-8) 0;
    border-top: 1px solid var(--line);
    margin-top: var(--s-8);
  }
  .nl-related h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(28px, 3vw, 40px);
    text-transform: uppercase;
    margin: 0 0 var(--s-5);
    letter-spacing: 0.02em;
  }
  .nl-related__viewport {
    position: relative;
  }
  .nl-related__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-5);
  }
  .nl-card {
    background: var(--snow);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .nl-card__photo {
    aspect-ratio: 16/10;
    background-size: cover;
    background-position: center;
  }
  .nl-card--oct .nl-card__photo {
    background: url('once-upon-a-time-assets/newsletter/related-oct-tomatoes.jpg?v=2') center/cover no-repeat;
  }
  .nl-card--nov .nl-card__photo {
    background: url('once-upon-a-time-assets/newsletter/related-nov-ballet.jpg?v=2') center/cover no-repeat;
  }
  .nl-card--dec .nl-card__photo {
    background: url('once-upon-a-time-assets/newsletter/related-dec-skyline.jpg?v=2') center/cover no-repeat;
  }
  .nl-card__body {
    padding: var(--s-4) var(--s-5);
  }
  .nl-card__date {
    font-family: var(--serif);
    font-weight: 400;
    font-size: var(--t-h4);
    text-transform: uppercase;
    margin: 0 0 4px;
    letter-spacing: 0.02em;
  }
  .nl-card__meta {
    font-size: var(--t-micro);
    color: var(--ink-muted);
    margin: 0 0 var(--s-3);
    display: flex;
    justify-content: space-between;
  }
  .nl-card__copy {
    font-size: var(--t-label);
    color: var(--ink);
    margin: 0 0 var(--s-3);
    line-height: var(--lh-body);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .nl-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }
  .nl-card__icons {
    display: inline-flex;
    gap: 6px;
    color: var(--ink-muted);
  }
  .nl-card__icons button {
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 4px;
    color: inherit;
  }
  .nl-related__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    right: -22px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--snow);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  @media (max-width: 900px) {
    .nl-feature,
    .nl-article,
    .nl-article--reverse {
      grid-template-columns: 1fr;
    }
    .nl-feature__body {
      column-count: 1;
    }
    .nl-article--reverse .nl-article__photo {
      order: 0;
    }
    .nl-related__grid {
      grid-template-columns: 1fr;
    }
    .nl-toolbar {
      flex-direction: column;
      align-items: flex-start;
    }
    .nl-related__arrow {
      display: none;
    }
  }
  @media (max-width: 540px) {
    .nl-toolbar {
      flex-direction: column;
      align-items: stretch;
    }
    .nl-tabs {
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .nl-tabs::-webkit-scrollbar {
      display: none;
    }
    .nl-tabs a {
      white-space: nowrap;
      flex-shrink: 0;
    }
    .nl-feature__grid {
      grid-template-columns: 1fr;
    }
    .nl-card-grid {
      grid-template-columns: 1fr;
    }
    .nl-involved-grid {
      grid-template-columns: 1fr;
    }
  }
  /* Per-page button override (Figma AI Prototype): this frame uses --rose
       fill for Buttons/Button-brand, not the global Woody Brown default. */
  .btn {
    --btn-bg: var(--rose);
    --btn-bg-hover: var(--rose-700);
    --btn-ring: var(--rose);
