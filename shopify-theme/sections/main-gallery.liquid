<style>
  @media (max-width: 720px) {
    .gallery-grid {
      grid-template-columns: 1fr 1fr !important;
    }
  }
  @media (max-width: 540px) {
    .gallery-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<section class='page-hero'>
