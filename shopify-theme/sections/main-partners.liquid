<section class="page-hero"><div class="wrap"><div class="page-hero__eyebrow">In good company</div>
    <h1>Our Partners</h1><p class="page-hero__sub">Foundations, businesses, and community organizations who collaborate with us.</p></div></section>
    <section class="wrap" style="padding:48px 0;max-width:980px">
      <h2 style="font-family:var(--serif);font-size:24px;text-transform:uppercase;margin:0 0 20px;color:var(--pillar)">Foundation grants</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px;margin-bottom:48px">
        <div style="background:var(--snow);border:1px solid var(--line);border-radius:12px;padding:24px;text-align:center;font-family:var(--serif);font-size:18px;color:var(--pillar)">NY State Council on the Arts</div><div style="background:var(--snow);border:1px solid var(--line);border-radius:12px;padding:24px;text-align:center;font-family:var(--serif);font-size:18px;color:var(--pillar)">Queens Community Fund</div><div style="background:var(--snow);border:1px solid var(--line);border-radius:12px;padding:24px;text-align:center;font-family:var(--serif);font-size:18px;color:var(--pillar)">Donata Foundation</div><div style="background:var(--snow);border:1px solid var(--line);border-radius:12px;padding:24px;text-align:center;font-family:var(--serif);font-size:18px;color:var(--pillar)">MJ Henley Trust</div><div style="background:var(--snow);border:1px solid var(--line);border-radius:12px;padding:24px;text-align:center;font-family:var(--serif);font-size:18px;color:var(--pillar)">Bloomberg Philanthropies</div>
      </div>
      <h2 style="font-family:var(--serif);font-size:24px;text-transform:uppercase;margin:0 0 20px;color:var(--pillar)">Community partners</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px;margin-bottom:48px">
        <div style="background:var(--snow);border:1px solid var(--line);border-radius:12px;padding:24px;text-align:center;font-family:var(--serif);font-size:18px;color:var(--pillar)">Queens Botanical Garden</div><div style="background:var(--snow);border:1px solid var(--line);border-radius:12px;padding:24px;text-align:center;font-family:var(--serif);font-size:18px;color:var(--pillar)">Richmond Hill Library</div><div style="background:var(--snow);border:1px solid var(--line);border-radius:12px;padding:24px;text-align:center;font-family:var(--serif);font-size:18px;color:var(--pillar)">PS 124</div><div style="background:var(--snow);border:1px solid var(--line);border-radius:12px;padding:24px;text-align:center;font-family:var(--serif);font-size:18px;color:var(--pillar)">PS 56</div><div style="background:var(--snow);border:1px solid var(--line);border-radius:12px;padding:24px;text-align:center;font-family:var(--serif);font-size:18px;color:var(--pillar)">Queens Public Theater</div><div style="background:var(--snow);border:1px solid var(--line);border-radius:12px;padding:24px;text-align:center;font-family:var(--serif);font-size:18px;color:var(--pillar)">Borough President&#39;s Office</div>
      </div>
      <h2 style="font-family:var(--serif);font-size:24px;text-transform:uppercase;margin:0 0 20px;color:var(--pillar)">Corporate sponsors</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px">
        <div style="background:var(--snow);border:1px solid var(--line);border-radius:12px;padding:24px;text-align:center;font-family:var(--serif);font-size:16px;color:var(--rose-700)">Eigenhitchens, Inc.</div><div style="background:var(--snow);border:1px solid var(--line);border-radius:12px;padding:24px;text-align:center;font-family:var(--serif);font-size:16px;color:var(--rose-700)">The Henry Trust</div><div style="background:var(--snow);border:1px solid var(--line);border-radius:12px;padding:24px;text-align:center;font-family:var(--serif);font-size:16px;color:var(--rose-700)">Sherlock Family Foundation</div><div style="background:var(--snow);border:1px solid var(--line);border-radius:12px;padding:24px;text-align:center;font-family:var(--serif);font-size:16px;color:var(--rose-700)">Pepsi-Cola NY</div><div style="background:var(--snow);border:1px solid var(--line);border-radius:12px;padding:24px;text-align:center;font-family:var(--serif);font-size:16px;color:var(--rose-700)">Steinway &amp; Sons</div>
      </div>
      <div style="margin-top:48px;text-align:center;background:var(--rose-50);border-radius: var(--radius-md);padding:32px">
        <h3 style="font-family:var(--serif);font-size:22px;text-transform:uppercase;margin:0 0 8px;color:var(--pillar)">Become a partner</h3>
        <p style="font-size:14px;color:var(--ink-muted);max-width:50ch;margin:0 auto 18px">Sponsorships, in-kind donations, and grant collaborations all welcome.</p>
        <a class="btn" href="sponsorship.html">View sponsorship tiers <i class="ph ph-arrow-right"></i></a>
      </div>
    </section>

