<style>
:root { --bg: var(--beginning); --hero-rose: var(--rose-100); }
    body { margin: 0; background: var(--bg); font-family: var(--sans); color: var(--ink); }
    .wrap { width: min(1200px, 100% - 32px); margin-inline: auto; }

    /* Hero — soft horizontal gradient, mirrors donate.html */
    .hero {
      position: relative;
      padding: 28px 0 0;
      background: linear-gradient(90deg, var(--rose-100) 0%, var(--rose-100) 45%, var(--rose-50) 75%, var(--beginning) 100%);
      overflow: hidden;
    }
    .hero__grid {
      display: grid; grid-template-columns: 1.1fr 1fr;
      gap: 48px; align-items: center;
      padding-bottom: 32px;
    }
    .pill {
      display: inline-flex; align-items: center; gap: 10px;
      background: var(--blush); color: var(--ink);
      padding: 10px 20px; border-radius: 999px;
      font-size: 14px; font-weight: 500;
    }
    .pill::before {
      content: ""; width: 16px; height: 16px;
      background: var(--ink);
      -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 21s-7.5-4.6-9.6-9.3C1.1 8.6 2.6 5 6.1 5c2.1 0 3.5 1.2 4.4 2.6h.6C12 6.2 13.4 5 15.5 5 19 5 20.5 8.6 19.6 11.7 17.5 16.4 12 21 12 21z'/></svg>") center/contain no-repeat;
              mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 21s-7.5-4.6-9.6-9.3C1.1 8.6 2.6 5 6.1 5c2.1 0 3.5 1.2 4.4 2.6h.6C12 6.2 13.4 5 15.5 5 19 5 20.5 8.6 19.6 11.7 17.5 16.4 12 21 12 21z'/></svg>") center/contain no-repeat;
    }
    h1.hero__title {
      font-family: var(--serif); font-weight: 600;
      font-size: clamp(40px, 6vw, 70px);
      line-height: 1.02;
      letter-spacing: -0.01em;
      text-transform: uppercase;
      margin: 18px 0 20px;
      color: var(--pillar);
    }
    .hero__lede { font-size: 15px; max-width: 46ch; color: var(--ink-muted); margin: 0 0 28px; line-height: 1.6; }
    .hero__cta {
      background: var(--rose); color: var(--snow);
      padding: 13px 24px; border-radius: var(--radius);
      font-weight: 600; font-size: 14px;
      text-decoration: none; display: inline-block;
    }
    .hero__cta:hover { background: var(--rose-700); }
    .hero__media { position: relative; padding: 12px 12px 40px 40px; }
    .hero__image {
      position: relative;
      border-radius: 6px; overflow: hidden;
      aspect-ratio: 5 / 4; min-height: 280px;
      background: linear-gradient(160deg, rgba(139,80,68,.45) 0%, rgba(76,47,59,.55) 100%),
                  url("once-upon-a-time-assets/img/hero.jpg") center/cover no-repeat;
      background-blend-mode: multiply, normal;
      box-shadow: 0 20px 40px rgba(76,47,59,.20);
      transform: rotate(-2.5deg);
    }
    .hero__chip {
      position: absolute; left: 0; bottom: 0;
      background: var(--blush); color: var(--pillar);
      padding: 18px 22px; border-radius: 12px;
      font-size: 13px; line-height: 1.4;
      box-shadow: 0 12px 24px rgba(76,47,59,.18);
      min-width: 140px;
    }
    .hero__chip small { display: block; font-size: 13px; color: var(--pillar); font-weight: 500; }
    .hero__chip strong { display: block; font-family: var(--sans); font-size: 22px; font-weight: 700; color: var(--pillar); margin: 4px 0; }
    .hero__divider { height: 1px; background: rgba(76,47,59,.20); margin: 8px 0 28px; }
    .hero__stats { display: flex; gap: 64px; flex-wrap: wrap; padding: 0 0 32px; }
    .hero__stat-num { font-family: var(--serif); font-size: 36px; font-weight: 600; line-height: 1; color: var(--pillar); }
    .hero__stat-label { font-size: 12px; color: var(--ink-muted); margin-top: 6px; }

    /* Payment panel */
    .payment-wrap { background: var(--rose-100); padding: 56px 0 80px; }
    .payment-back {
      display: inline-flex; align-items: center; gap: 8px;
      color: var(--ink-muted); text-decoration: none;
      font-size: 14px; margin: 0 0 20px;
      padding: 4px 8px;
    }
    .payment-back:hover { color: var(--ink); }
    .payment-card {
      max-width: 720px; margin: 0 auto;
      background: var(--snow); border-radius: var(--radius-md);
      padding: 40px 48px;
      box-shadow: 0 8px 32px rgba(76,47,59,.10);
    }
    .payment-card h1 {
      font-family: var(--serif); font-weight: 400;
      font-size: clamp(26px, 3vw, 32px);
      color: var(--ink-muted);
      margin: 0 0 28px;
    }
    .payment-method {
      border: 0; padding: 0; margin: 0 0 28px;
    }
    .pm-row {
      display: flex; align-items: center; gap: 12px;
      font-size: 16px; font-weight: 600;
      margin-bottom: 16px;
    }
    .pm-row input[type="radio"] {
      appearance: none;
      width: 18px; height: 18px; border-radius: 50%;
      border: 1.5px solid var(--rose); background: var(--snow);
      margin: 0; display: grid; place-items: center; cursor: pointer;
    }
    .pm-row input[type="radio"]:checked::after {
      content: ""; width: 9px; height: 9px;
      background: var(--rose); border-radius: 50%;
    }
    .pm-row__icons {
      margin-left: auto;
      display: inline-flex; gap: 6px; align-items: center;
    }
    .pm-row__icons img { height: 22px; }
    .card-icon {
      display: inline-flex; align-items: center; justify-content: center;
      height: 22px; padding: 0 6px;
      border: 1px solid var(--line); border-radius: 4px;
      font-size: 9px; font-weight: 700; letter-spacing: .04em;
      background: var(--snow); color: var(--ink);
      text-transform: uppercase;
    }
    .card-icon--discover { color: #ff6000; }
    .card-icon--visa { color: #1a1f71; }
    .card-icon--mc { background: linear-gradient(90deg, #eb001b 50%, #f79e1b 50%); color: transparent; -webkit-background-clip: text; background-clip: text; }
    .card-icon--amex { color: #006fcf; }

    .pm-fields { display: grid; gap: 16px; padding-left: 30px; margin-bottom: 28px; }
    .pm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .pm-grid--3 { grid-template-columns: 1fr 1fr 1fr; }
    .field { display: flex; flex-direction: column; gap: 6px; }
    .field__label { font-size: 13px; color: var(--ink-muted); font-weight: 500; }
    .input {
      width: 100%; min-height: 40px; padding: 0 12px;
      border: 1px solid var(--line); border-radius: var(--radius-sm);
      background: var(--snow); color: var(--ink); font-size: var(--t-label);
    }
    .input:focus { outline: none; border-color: var(--rose); box-shadow: 0 0 0 3px var(--rose-100); }

    .billing-title {
      font-size: 14px; font-weight: 700; color: var(--ink);
      margin: 4px 0 0;
    }

    .pm-monthly {
      display: flex; align-items: center; gap: 12px;
      padding-left: 30px;
      font-size: 14px; color: var(--ink-muted);
    }
    .pm-monthly input[type="radio"] {
      appearance: none;
      width: 16px; height: 16px; border-radius: 50%;
      border: 1.5px solid var(--rose); background: var(--snow);
      margin: 0; cursor: pointer;
      display: grid; place-items: center;
    }
    .pm-monthly input[type="radio"]:checked::after { content: ""; width: 8px; height: 8px; background: var(--rose); border-radius: 50%; }

    .donate-submit {
      display: block; width: calc(100% - 96px);
      margin: 32px auto 0;
      min-height: 56px;
      background: var(--n-200);
      color: var(--snow);
      border: 0; border-radius: 12px;
      font-size: 16px; font-weight: 600;
      cursor: pointer;
    }
    .donate-submit.is-active { background: var(--rose); }
    .donate-submit:hover.is-active { background: var(--rose-700); }

    @media (max-width: 1024px) {
      .hero__grid { grid-template-columns: 1fr; gap: 28px; }
      .pm-fields, .pm-monthly { padding-left: 0; }
      .pm-grid, .pm-grid--3 { grid-template-columns: 1fr; }
      .payment-card { padding: 28px 22px; }
      .donate-submit { width: 100%; }
    }
</style>

<!-- HERO (mirrors donate.html) -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero__grid">
        <div class="hero__copy">
          <span class="pill">Making a Difference Together</span>
          <h1 id="hero-title" class="hero__title">Help us create<br>lasting impact</h1>
          <p class="hero__lede">
            Your donation directly supports communities in need, providing essential
            resources, education, and hope for a better tomorrow. Join thousands of
            supporters making a difference.
          </p>
          <a href="donate.html#donate" class="hero__cta">Donate Now</a>
        </div>
        <div class="hero__media">
          <div class="hero__image" role="img" aria-label="Volunteers gathered together at a community event"></div>
          <div class="hero__chip" aria-hidden="true">
            <small>This month</small>
            <strong>1,247</strong>
            <small>people helped</small>
          </div>
        </div>
      </div>
      <div class="wrap">
        <div class="hero__divider" aria-hidden="true"></div>
        <div class="hero__stats" role="list" aria-label="Headline impact numbers">
          <div role="listitem"><div class="hero__stat-num">50K+</div><div class="hero__stat-label">Lives Impacted</div></div>
          <div role="listitem"><div class="hero__stat-num">$2M+</div><div class="hero__stat-label">Funds Raised</div></div>
          <div role="listitem"><div class="hero__stat-num">100+</div><div class="hero__stat-label">Projects</div></div>
        </div>
      </div>
    </section>

    <!-- PAYMENT -->
    <section class="payment-wrap" aria-labelledby="payment-title">
      <div class="wrap">
        <a class="payment-back" href="donate.html#donate"><i class="ph ph-arrow-left" aria-hidden="true"></i> Back</a>

        <form class="payment-card" id="payment-form" novalidate>
          <h2 id="payment-title">Choose a payment method</h2>

          <fieldset class="payment-method">
            <legend class="sr-only">Payment options</legend>

            <label class="pm-row">
              <input type="radio" name="method" value="card" checked>
              <span>Credit or Debit Card</span>
              <span class="pm-row__icons" aria-hidden="true">
                <span class="card-icon card-icon--discover">Discover</span>
                <span class="card-icon card-icon--visa">VISA</span>
                <span class="card-icon card-icon--mc">MC</span>
                <span class="card-icon card-icon--amex">AMEX</span>
              </span>
            </label>

            <div class="pm-fields" data-method-fields="card">
              <label class="field">
                <span class="field__label">Name on Card</span>
                <input class="input" name="card-name" type="text" autocomplete="cc-name" required>
              </label>
              <label class="field">
                <span class="field__label">Card number</span>
                <input class="input" name="card-number" type="text" inputmode="numeric" autocomplete="cc-number" placeholder="1234 1234 1234 1234" required>
              </label>
              <div class="pm-grid">
                <label class="field">
                  <span class="field__label">Expiry Date (MM/YY)</span>
                  <input class="input" name="card-exp" type="text" inputmode="numeric" autocomplete="cc-exp" placeholder="MM/YY" required>
                </label>
                <label class="field">
                  <span class="field__label">CVV <button type="button" class="cvv-help" aria-label="What is CVV?" data-mock-toast="The CVV is the 3-digit code on the back of your card (4 digits on the front for Amex)." style="background:transparent;border:0;color:var(--ink-muted);cursor:pointer;padding:2px;font-size:14px;vertical-align:middle"><i class="ph ph-question" aria-hidden="true"></i></button></span>
                  <input class="input" name="card-cvv" type="text" inputmode="numeric" autocomplete="cc-csc" placeholder="CVV" required>
                </label>
              </div>
              <div class="pm-grid">
                <label class="field">
                  <span class="field__label">Country</span>
                  <input class="input" name="country" type="text" autocomplete="country-name" placeholder="United States" required>
                </label>
                <label class="field">
                  <span class="field__label">ZIP Code</span>
                  <input class="input" name="zip" type="text" autocomplete="postal-code" placeholder="11418" required>
                </label>
              </div>

              <p class="billing-title">Billing Address</p>

              <label class="field">
                <span class="field__label">Street</span>
                <input class="input" name="street" type="text" autocomplete="address-line1" required>
              </label>
              <div class="pm-grid--3 pm-grid">
                <label class="field">
                  <span class="field__label">Apartment Number</span>
                  <input class="input" name="apt" type="text" autocomplete="address-line2">
                </label>
                <label class="field">
                  <span class="field__label">State</span>
                  <input class="input" name="state" type="text" autocomplete="address-level1" required>
                </label>
                <label class="field">
                  <span class="field__label">ZIP Code</span>
                  <input class="input" name="billing-zip" type="text" autocomplete="postal-code" required>
                </label>
              </div>
            </div>

            <label class="pm-row">
              <input type="radio" name="method" value="paypal">
              <span>Paypal</span>
              <span class="pm-row__icons" aria-hidden="true">
                <span class="card-icon" style="color:#003087; font-style:italic;">PayPal</span>
              </span>
            </label>

            <div class="pm-fields" data-method-fields="paypal" style="display:none;padding:var(--s-4) 0">
              <p style="font-size:14px;color:var(--ink-muted);margin:0 0 16px">You'll be redirected to PayPal to complete your donation securely.</p>
              <button type="button" class="btn" data-mock="paypal-redirect" style="background:#003087;color:var(--snow)">
                <i class="ph ph-paypal-logo" aria-hidden="true"></i> Continue with PayPal
              </button>
            </div>

            <label class="pm-row">
              <input type="radio" name="method" value="apple">
              <span>Apple Pay</span>
              <span class="pm-row__icons" aria-hidden="true">
                <span class="card-icon" style="background:#000;color:#fff;border-color:#000;"><i class="ph ph-apple-logo" style="font-size:11px;margin-right:2px"></i>Pay</span>
              </span>
            </label>
          </fieldset>

          <label class="pm-monthly">
            <input type="checkbox" name="monthly" style="appearance:none;width:16px;height:16px;border-radius:50%;border:1.5px solid var(--rose);background:var(--snow);cursor:pointer;display:grid;place-items:center;">
            <span>Check the Box if you want to pay every month</span>
          </label>

          <p id="impact-personal" style="text-align:center;font-size:13px;color:var(--garden-700);margin:16px 0 0;font-weight:500">
            Your $100 sponsors a full program enrollment for one child.
          </p>

          <button type="submit" class="donate-submit" id="donate-submit">Donate $100 Now</button>
          <p style="text-align:center;font-size:12px;color:var(--ink-muted);margin-top:14px">Demo: <a href="payment-declined.html" style="color:var(--rose);text-decoration:underline">preview a declined payment</a></p>
        </form>
      </div>
    </section>

{% schema %}
{
  "name": "Payment \u2014 Main",
  "tag": "section",
  "settings": []
}
{% endschema %}
