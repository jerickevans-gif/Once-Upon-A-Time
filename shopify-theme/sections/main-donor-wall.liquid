<style>
  @media (max-width: 540px) {
    .donor-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<section class='page-hero'>
  <div class='wrap'>
    <div class='page-hero__eyebrow'>Thank you</div>
    <h1>Our Donor Community</h1>
    <p class='page-hero__sub'>
      Every supporter listed below opted to be acknowledged publicly. Your generosity is the engine of OUAT.
    </p>
  </div>
</section>
<section class='wrap' style='padding:48px 0;max-width:880px'>
  <div style='background:var(--snow);border:1px solid var(--line);border-radius: var(--radius-md);padding:32px;margin-bottom:24px'>
    <div style='font-size:11px;font-weight:700;letter-spacing:.25em;color:var(--rose-700);text-transform:uppercase;margin-bottom:8px'>
      Leadership Circle
    </div>
    <p style='font-size:13px;color:var(--ink-muted);margin:0 0 16px'>$5,000+ this year</p>
    <div
      class='donor-grid'
      style='display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px;font-family:var(--serif);font-size:18px'
    >
      <div>The Sherlock Family</div>
      <div>Anonymous</div>
      <div>Eigenhitchens Foundation</div>
      <div>The Henry Trust</div>
    </div>
  </div>
  <div style='background:var(--snow);border:1px solid var(--line);border-radius: var(--radius-md);padding:32px;margin-bottom:24px'>
    <div style='font-size:11px;font-weight:700;letter-spacing:.25em;color:var(--rose-700);text-transform:uppercase;margin-bottom:8px'>
      Sustaining Donors
    </div>
    <p style='font-size:13px;color:var(--ink-muted);margin:0 0 16px'>$1,000–$4,999 this year</p>
    <div
      class='donor-grid'
      style='display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;font-size:15px'
    >
      <div>Lena Stuart</div>
      <div>Sydney Phelps</div>
      <div>Mia Kim</div>
      <div>Anonymous</div>
      <div>Lara Stuart</div>
      <div>The Diaz Family</div>
      <div>Patrick &amp; Mary Henderson</div>
      <div>Anonymous</div>
    </div>
  </div>
  <div style='background:var(--snow);border:1px solid var(--line);border-radius: var(--radius-md);padding:32px'>
    <div style='font-size:11px;font-weight:700;letter-spacing:.25em;color:var(--rose-700);text-transform:uppercase;margin-bottom:8px'>
      Friends &amp; Supporters
    </div>
    <p style='font-size:13px;color:var(--ink-muted);margin:0 0 16px'>All recurring monthly donors</p>
    <div
      class='donor-grid'
      style='display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:8px;font-size:13px;color:var(--ink)'
    >
      <div>Maria Rodriguez</div>
      <div>Dr. James Chen</div>
      <div>Sarah Thompson</div>
      <div>Anonymous (12)</div>
      <div>The Rodriguez Family</div>
      <div>The Sherlock Family</div>
      <div>Lena Pinelli</div>
      <div>Courtney Henry</div>
      <div>Yasmine Rodriguez</div>
      <div>Anonymous</div>
    </div>
  </div>
  <div style='margin-top:32px;text-align:center'>
    <a class='btn' href='donate.html'>Join the donor community <i class='ph ph-arrow-right'></i></a>
  </div>
</section>

