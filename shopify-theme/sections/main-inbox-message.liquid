<section class='wrap' style='max-width:760px;padding:32px 24px 80px'>
  <a
    href='inbox.html'
    style='font-size:14px;color:var(--ink-muted);text-decoration:none;display:inline-flex;gap:6px;align-items:center;margin-bottom:18px'
    ><i class='ph ph-arrow-left'></i> Back to inbox</a
  >
  <article style='background:var(--snow);border:1px solid var(--line);border-radius: var(--radius-md);padding:32px'>
    <header style='display:flex;align-items:flex-start;justify-content:space-between;gap:18px;padding-bottom:24px;border-bottom:1px solid var(--line);margin-bottom:24px;flex-wrap:wrap'>
      <div style='display:flex;gap:14px;align-items:center'>
        <div
          id='msg-avatar'
          style='width:48px;height:48px;border-radius:50%;background:var(--rose-100);color:var(--rose-700);display:inline-flex;align-items:center;justify-content:center;font-family:var(--serif);font-weight:600;font-size:20px'
        >
          L
        </div>
        <div>
          <div id='msg-from' style='font-weight:700;font-size:14px'>Luna Pinelli</div>
          <div id='msg-from-sub' style='font-size:12px;color:var(--ink-muted)'>Beginner Ballet · OUAT staff</div>
        </div>
      </div>
      <div style='display:flex;gap:6px'>
        <button
          type='button'
          class='nl-action'
          aria-label='Star'
          aria-pressed='false'
          data-bookmark='msg:1'
          style='width:36px;height:36px;border:0;border-radius:8px;background:var(--rose-100);color:var(--rose-700);cursor:pointer'
        >
          <i class='ph ph-star'></i>
        </button>
        <button
          type='button'
          class='nl-action'
          aria-label='Reply'
          data-mock='reply-message'
          data-mock-toast='Reply composer opens via Shopify Inbox in production.'
          style='width:36px;height:36px;border:0;border-radius:8px;background:var(--rose-700);color:var(--snow);cursor:pointer'
        >
          <i class='ph ph-arrow-bend-up-left'></i>
        </button>
        <button
          type='button'
          class='nl-action'
          aria-label='Archive'
          data-mock='archive-message'
          data-mock-toast='Archived. (Restored from your Inbox archive in production.)'
          style='width:36px;height:36px;border:0;border-radius:8px;background:var(--snow);border:1px solid var(--line);color:var(--ink);cursor:pointer'
        >
          <i class='ph ph-archive'></i>
        </button>
      </div>
    </header>
    <h1
      id='msg-title'
      style='font-family:var(--serif);font-size:28px;text-transform:uppercase;margin:0 0 8px;color:var(--pillar)'
    >
      Welcome to next week's session
    </h1>
    <p id='msg-time' style='font-size:13px;color:var(--ink-muted);margin:0 0 24px'>
      2 hours ago · Reply by Mon, May 11
    </p>
    <div id='msg-body' style='font-size:15px;line-height:1.7;color:var(--ink)'>
      <p>Hi Claire,</p>
      <p>
        A quick reminder that Daisy's Mar 10 class moves to Studio Room A. Please arrive 10 minutes early so we can get
        her warmed up before we begin — we'll be working on the Mar 28 showcase routine together.
      </p>
      <p>Two small asks:</p>
      <ul style='padding-left:24px;margin:0 0 12px'>
        <li>Confirm the showcase costume color (rose or cream) by Friday</li>
        <li>Sign and return the May 16 field-trip permission slip — emailed separately</li>
      </ul>
      <p>Reply if anything changes!</p>
      <p>— Luna</p>
    </div>
    <div style='margin-top:32px;padding-top:24px;border-top:1px solid var(--line);display:flex;gap:10px;flex-wrap:wrap'>
      <button
        type='button'
        class='btn'
        data-mock='reply-message'
        data-mock-toast='Reply composer opens via Shopify Inbox in production.'
      >
        <i class='ph ph-arrow-bend-up-left'></i> Reply
      </button>
      <button
        type='button'
        class='btn btn--ghost'
        data-mock='forward-message'
        data-mock-toast='Forward dialog opens via Shopify Inbox in production.'
      >
        <i class='ph ph-arrow-bend-up-right'></i> Forward
      </button>
      <a class='btn btn--text' href='profile.html'
        >View Daisy's profile <i class='ph ph-arrow-right' aria-hidden='true'></i
      ></a>
    </div>
  </article>
</section>

{% schema %}
{
  "name": "Inbox Message \u2014 Main",
  "tag": "section",
  "settings": []
}
{% endschema %}
