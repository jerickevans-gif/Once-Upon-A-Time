<!-- ============ HERO ============ -->
    <section class="pd-hero" role="img" aria-label="Students dancing in a seasonal camp performance"></section>

    <!-- ============ QUICK FACTS ============ -->
    <div class="quick-facts wrap" role="region" aria-label="Program quick facts" style="margin:var(--s-5) auto">
      <dl class="quick-facts__list" style="display:flex;flex-wrap:wrap;gap:var(--s-5);margin:0;padding:0">
        <div class="quick-facts__item" style="flex:1 1 auto;min-width:140px">
          <dt style="font-family:var(--sans);font-size:var(--t-micro);font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--ink-muted);display:flex;align-items:center;gap:var(--s-1);margin-bottom:var(--s-1)"><i class="ph ph-calendar-blank" aria-hidden="true"></i> Dates</dt>
          <dd style="margin:0;font-size:var(--t-base);font-weight:600;color:var(--ink)">Aug 5 — Dec 7, 2025</dd>
        </div>
        <div class="quick-facts__item" style="flex:1 1 auto;min-width:140px">
          <dt style="font-family:var(--sans);font-size:var(--t-micro);font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--ink-muted);display:flex;align-items:center;gap:var(--s-1);margin-bottom:var(--s-1)"><i class="ph ph-currency-dollar" aria-hidden="true"></i> Tuition</dt>
          <dd style="margin:0;font-size:var(--t-base);font-weight:600;color:var(--ink)">$50 down / $150 total</dd>
        </div>
        <div class="quick-facts__item" style="flex:1 1 auto;min-width:140px">
          <dt style="font-family:var(--sans);font-size:var(--t-micro);font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--ink-muted);display:flex;align-items:center;gap:var(--s-1);margin-bottom:var(--s-1)"><i class="ph ph-users" aria-hidden="true"></i> Capacity</dt>
          <dd style="margin:0;font-size:var(--t-base);font-weight:600;color:var(--ink)">5 of 10 slots available</dd>
        </div>
        <div class="quick-facts__item" style="flex:1 1 auto;min-width:140px">
          <dt style="font-family:var(--sans);font-size:var(--t-micro);font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--ink-muted);display:flex;align-items:center;gap:var(--s-1);margin-bottom:var(--s-1)"><i class="ph ph-baby" aria-hidden="true"></i> Ages</dt>
          <dd style="margin:0;font-size:var(--t-base);font-weight:600;color:var(--ink)">8 — 15</dd>
        </div>
      </dl>
    </div>

    <!-- ============ BODY ============ -->
    <section class="pd-body">
      <div class="wrap pd-body__grid">

        <!-- Sidebar -->
        <aside class="pd-side" aria-label="Page sections">
          <details class="sidebar-collapse" open>
            <summary>Page Sections <i class="ph ph-caret-down" aria-hidden="true"></i></summary>
            <nav class="sidebar-collapse__nav pd-side__nav">
              <a href="#program-info" class="is-active">Program Info</a>
              <a href="#instructors">Instructors</a>
              <a href="#class-location">Class Location</a>
              <a href="#faqs">FAQs</a>
            </nav>
          </details>

          <div class="pd-capacity">
            <div class="pd-capacity__top">
              <div>
                <span class="pd-capacity__label"><i class="ph ph-info"></i> Class Capacity</span>
                <span class="pd-capacity__sub">5 of 10 slots available</span>
              </div>
              <a class="btn" href="enrollment.html?class=seasonal-camps" data-register data-register-title="Seasonal Camps" data-register-schedule="Mondays – Thursdays | 3pm | Ages 10+ | Studio Room A" data-register-seats="5 of 10" data-register-price="$50.00" data-register-action="enrollment.html?class=seasonal-camps">Register now <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="pd-capacity__price-card">
              <div class="pd-capacity__price">$50.00</div>
              <p>Down payment required</p>
            </div>
          </div>
        </aside>

        <!-- Main content -->
        <article class="pd-main">
          <h1>Seasonal&nbsp;Camps</h1>

          <!-- PROGRAM INFO -->
          <section class="pd-section" id="program-info" aria-labelledby="program-info-title">
            <h2 id="program-info-title">Program Info</h2>

            <div class="pd-sub">
              <h3>Overview</h3>
              <p>This winter, children will discover the rhythm of jazz through music, movement, and play. Our guided sessions help build listening skills and creative confidence, leading up to a special onstage performance where children get to play instruments and the audience feels the music.</p>
            </div>

            <div class="pd-sub">
              <h3>Class Schedule</h3>
              <p>Program Dates: <strong>Aug 5 &ndash; Dec 7, 2025</strong></p>
              <p>MON &middot; WED &middot; FRI (5PM &ndash; 7PM)</p>
              <p>Public Holiday: <strong>Holiday 1, Holiday 2, Holiday 3</strong></p>
            </div>

            <div class="pd-sub">
              <h3>Eligibility</h3>
              <ul>
                <li>Ages 8&ndash;15</li>
                <li>2-months commitment</li>
              </ul>
            </div>

            <div class="pd-sub">
              <h3>Program Components</h3>
              <ul class="pd-components">
                <li>Dance</li>
                <li>Gardening</li>
                <li>Theater</li>
                <li>Visual Art</li>
                <li>Cooking</li>
                <li>Music</li>
              </ul>
            </div>
          </section>

          <hr class="pd-divider">

          <!-- INSTRUCTORS -->
          <section class="pd-section" id="instructors" aria-labelledby="instructors-title">
            <h2 id="instructors-title">Instructors</h2>
            <div class="pd-instructors">
              <article class="pd-instructor pd-instructor--courtney">
                <div class="pd-instructor__photo" role="img" aria-label="Portrait of Courtney Diaz"></div>
                <h3>Courtney Diaz</h3>
                <p class="pd-instructor__role">Dance Instructor</p>
                <p class="pd-instructor__philosophy" style="font-style:italic;font-size:var(--t-label);color:var(--rose-700);margin:0 0 var(--s-3);line-height:var(--lh-body)">"Every child has a story worth telling on stage."</p>
                <p class="pd-instructor__bio">Courtney is a dance instructor specialized in helping children develop strong foundations in movement. She creates a supportive learning environment where students can be their best and develop their dance moves.</p>
              </article>
              <article class="pd-instructor pd-instructor--darrell">
                <div class="pd-instructor__photo" role="img" aria-label="Portrait of Darrell Yun"></div>
                <h3>Darrell Yun</h3>
                <p class="pd-instructor__role">Music Instructor</p>
                <p class="pd-instructor__philosophy" style="font-style:italic;font-size:var(--t-label);color:var(--rose-700);margin:0 0 var(--s-3);line-height:var(--lh-body)">"Music is the language every child already speaks."</p>
                <p class="pd-instructor__bio">Darrell is a music instructor who shares an introduction to music, from rhythm to instruments. He provides hands-on activities where students build an understanding of music while offering instruments to play.</p>
              </article>
            </div>
          </section>

          <hr class="pd-divider">

          <!-- CLASS LOCATIONS -->
          <section class="pd-section" id="class-location" aria-labelledby="locations-title">
            <h2 id="locations-title">Class Locations</h2>
            <div class="pd-locations">
              <div class="pd-location-list">
                <div class="pd-sub">
                  <h3>Drop-Off &amp; Pickup</h3>
                  <p>Drop off and pickup can get busy &mdash; we recommend arriving early. If needed, one of us can help with picking up your child. Just let us know.</p>
                </div>
                <div class="pd-sub">
                  <h3>Address</h3>
                  <p>158-40 76th Rd, Fresh Meadows, NY 11366, United States</p>
                </div>
                <div class="pd-sub">
                  <h3>Contact</h3>
                  <p>+1 718-380-6929</p>
                </div>
              </div>
              <div class="pd-map" aria-label="Map showing class location at 158-40 76th Rd, Fresh Meadows, NY">
                <iframe class="pd-map__frame"
                  src="https://www.google.com/maps?q=158-40+76th+Rd+Fresh+Meadows+NY+11366&output=embed"
                  title="Class location map — 158-40 76th Rd, Fresh Meadows, NY"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"></iframe>
              </div>
            </div>
          </section>

          <hr class="pd-divider">

          <!-- FAQs -->
          <section class="pd-section" id="faqs" aria-labelledby="faqs-title">
            <h2 id="faqs-title">FAQs</h2>
            <details class="pd-sub">
              <summary><strong>What should my child bring to camp?</strong></summary>
              <p>Comfortable clothing, a refillable water bottle, and a packed snack. We provide all program materials.</p>
            </details>
            <details class="pd-sub">
              <summary><strong>Are scholarships available?</strong></summary>
              <p>Yes &mdash; partial and full scholarships are awarded on a rolling basis. Email <a href="mailto:contact@onceuponatime.org">contact@onceuponatime.org</a> for the application.</p>
            </details>
            <details class="pd-sub">
              <summary><strong>Can I drop in for a single session?</strong></summary>
              <p>Our seasonal camps require a 2-month commitment so students can build through the full arc, but private sessions are available for short-term enrollment.</p>
            </details>
          </section>

          <!-- Still have questions -->
          <div class="pd-help">
            <div>
              <h2>Still Have Questions?</h2>
              <p>Please write to our friendly support team or call us at <strong>+1 123-456-789</strong>.</p>
            </div>
            <a class="btn btn--outline" href="contact.html">Send Email</a>
          </div>

        </article>
      </div>
    </section>

    <!-- ============ ALTERNATIVES ============ -->
    <section class="pd-alts" aria-labelledby="alts-title">
      <div class="wrap">
        <h2 id="alts-title">Not what you&rsquo;re looking for?</h2>
        <div class="pd-alts__grid">
          <article class="pd-alt">
            <h3>Private Sessions</h3>
            <p>Our private sessions offer dedicated, one-on-one classes tailored to your child. We ensure they receive the same high-quality support and creative experiences as our group classes, but with a personalized focus on the topics they want to explore.</p>
            <a class="btn btn--outline btn--sm" href="private-lessons.html">View Details</a>
          </article>
          <article class="pd-alt">
            <h3>Create Your Own Path</h3>
            <p>This option lets students design their own learning journey across dance, music, art, and theater. Through hands-on activities, children can explore multiple creative styles at their own pace to discover what they love most.</p>
            <a class="btn btn--outline btn--sm" href="contact.html">View Details</a>
          </article>
        </div>
      </div>
    </section>

