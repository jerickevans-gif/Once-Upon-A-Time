<header class="site-header" role="banner">
  <div class="wrap site-header__inner">

    <button class="nav-toggle" type="button" aria-controls="primary-nav" aria-expanded="false" aria-label="Toggle navigation menu">
      <i class="ph ph-list" aria-hidden="true"></i>
    </button>

    <a href="{{ routes.root_url }}" class="brand brand--stacked" aria-label="{{ shop.name }}, home">
      <span class="brand__line">Once</span>
      <span class="brand__line">Upon</span>
      <span class="brand__line">A Time</span>
    </a>

    <form class="site-search" role="search" action="{{ routes.search_url }}" method="get">
      <label class="sr-only" for="site-search-input">Search the site</label>
      <input id="site-search-input" name="q" type="search" class="site-search__input" placeholder="Search" autocomplete="off" value="{{ search.terms | escape }}">
      <i class="ph ph-magnifying-glass site-search__icon" aria-hidden="true"></i>
    </form>

    <nav class="primary-nav" id="primary-nav" aria-label="Primary">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <div class="header-actions">
      <a href="{{ routes.cart_url }}" class="icon-btn icon-btn--cart" aria-label="Cart, {{ cart.item_count }} items">
        <i class="ph ph-shopping-cart-simple" aria-hidden="true"></i>
        {%- if cart.item_count > 0 -%}
          <span class="badge" aria-hidden="true">{{ cart.item_count }}</span>
        {%- endif -%}
        <span>Cart</span>
        <i class="ph ph-arrow-right" aria-hidden="true"></i>
      </a>

      <button class="icon-btn icon-btn--icon-only" type="button" aria-label="Settings">
        <i class="ph ph-gear" aria-hidden="true"></i>
      </button>

      {%- if customer -%}
        <a href="{{ routes.account_url }}" class="avatar avatar--dark" aria-label="Account">
          <i class="ph ph-user" aria-hidden="true"></i>
        </a>
      {%- else -%}
        <a href="{{ routes.account_login_url }}" class="avatar avatar--dark" aria-label="Sign in">
          <i class="ph ph-user" aria-hidden="true"></i>
        </a>
      {%- endif -%}
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Primary navigation", "default": "main-menu" }
  ]
}
{% endschema %}
