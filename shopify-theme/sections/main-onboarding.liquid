<section class="wrap" style="max-width:560px;padding:64px 24px;text-align:center">
      <div style="display:inline-flex;width:80px;height:80px;border-radius:50%;background:var(--rose-100);color:var(--rose-700);align-items:center;justify-content:center;font-size:38px;margin-bottom:20px"><i class="ph ph-confetti"></i></div>
      <h1 style="font-family:var(--serif);font-size:42px;text-transform:uppercase;margin:0 0 12px;color:var(--pillar)">Welcome, <span id="onboarding-name">Claire</span></h1>
      <p style="color:var(--ink-muted);margin:0 0 32px;line-height:1.7">Three quick steps to get the most out of your account.</p>

      <div style="display:grid;gap:14px;text-align:left">
        <a href="profile.html" style="display:grid;grid-template-columns:48px 1fr 24px;gap:16px;align-items:center;padding:20px;background:var(--snow);border:1px solid var(--line);border-radius:12px;text-decoration:none;color:inherit"><div style="width:48px;height:48px;border-radius:50%;background:var(--rose-50);color:var(--rose-700);display:inline-flex;align-items:center;justify-content:center;font-size:22px"><i class="ph ph-plus-circle"></i></div><div><div style="font-weight:700;font-size:15px;color:var(--ink)">Add a child profile</div><div style="font-size:13px;color:var(--ink-muted);margin-top:2px">Save details so enrollment is one click</div></div><i class="ph ph-arrow-right" style="color:var(--ink-muted)"></i></a><a href="programs.html" style="display:grid;grid-template-columns:48px 1fr 24px;gap:16px;align-items:center;padding:20px;background:var(--snow);border:1px solid var(--line);border-radius:12px;text-decoration:none;color:inherit"><div style="width:48px;height:48px;border-radius:50%;background:var(--rose-50);color:var(--rose-700);display:inline-flex;align-items:center;justify-content:center;font-size:22px"><i class="ph ph-magnifying-glass"></i></div><div><div style="font-weight:700;font-size:15px;color:var(--ink)">Browse programs</div><div style="font-size:13px;color:var(--ink-muted);margin-top:2px">Find a class that fits your schedule</div></div><i class="ph ph-arrow-right" style="color:var(--ink-muted)"></i></a><a href="preferences.html" style="display:grid;grid-template-columns:48px 1fr 24px;gap:16px;align-items:center;padding:20px;background:var(--snow);border:1px solid var(--line);border-radius:12px;text-decoration:none;color:inherit"><div style="width:48px;height:48px;border-radius:50%;background:var(--rose-50);color:var(--rose-700);display:inline-flex;align-items:center;justify-content:center;font-size:22px"><i class="ph ph-sliders-horizontal"></i></div><div><div style="font-weight:700;font-size:15px;color:var(--ink)">Set notification preferences</div><div style="font-size:13px;color:var(--ink-muted);margin-top:2px">Decide which emails you want</div></div><i class="ph ph-arrow-right" style="color:var(--ink-muted)"></i></a>
      </div>

      <div style="margin-top:40px">
        <a href="index.html" style="font-size:14px;color:var(--ink-muted)">Skip for now <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
      </div>
    </section>

