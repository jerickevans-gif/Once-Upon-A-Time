<style>
body { background: var(--beginning); margin: 0; }
    .enroll-wrap { max-width: 880px; margin: 32px auto; padding: 0 24px; }

    .enroll-head { margin-bottom: 24px; }
    .enroll-head a { color: var(--ink-muted); text-decoration: none; font-size: 14px; display: inline-flex; gap: 6px; align-items: center; }
    .enroll-head a:hover { color: var(--ink); }
    .enroll-title { font-family: var(--serif); font-size: clamp(28px, 4vw, 44px); margin: 12px 0 4px; text-transform: uppercase; }
    .enroll-sub { color: var(--ink-muted); margin: 0; font-size: 14px; }

    /* Stepper — base styles live in components.css; only need bottom-border + spacing tweak */
    .stepper { padding: 24px 0; border-bottom: 1px solid var(--line); }

    .panel {
      background: var(--snow); border: 1px solid var(--line);
      border-radius: 16px; padding: 32px;
      box-shadow: 0 4px 16px rgba(76,47,59,.06);
    }
    .panel + .panel { margin-top: 16px; }
    .panel__title { font-family: var(--serif); font-weight: 600; font-size: 24px; margin: 0 0 6px; color: var(--pillar); }
    .panel__sub { color: var(--ink-muted); margin: 0 0 24px; font-size: 14px; }

    /* Step content panes */
    [data-step] { display: none; }
    [data-step].is-active { display: block; }

    /* Step 1 — child picker */
    .child-picker { display: grid; gap: 10px; margin-bottom: 16px; }
    .child-pick {
      display: grid; grid-template-columns: 24px 1fr auto; gap: 14px; align-items: center;
      padding: 16px 18px;
      border: 1.5px solid var(--line); border-radius: 12px;
      cursor: pointer; transition: border-color .15s, background .15s;
      background: var(--snow);
    }
    .child-pick:hover { border-color: var(--rose-300); background: var(--rose-50); }
    .child-pick input[type="radio"] {
      appearance: none; width: 18px; height: 18px; border-radius: 50%;
      border: 1.5px solid var(--rose); background: var(--snow); margin: 0;
      display: grid; place-items: center;
    }
    .child-pick input[type="radio"]:checked::after { content: ""; width: 9px; height: 9px; background: var(--rose); border-radius: 50%; }
    .child-pick:has(input:checked) { border-color: var(--rose); background: var(--rose-50); }
    .child-pick__name { font-weight: 700; font-size: 15px; color: var(--ink); }
    .child-pick__meta { font-size: 12px; color: var(--ink-muted); margin-top: 2px; }
    .child-pick__age { font-size: 12px; color: var(--ink-muted); }

    .add-child {
      width: 100%;
      background: transparent; border: 1.5px dashed var(--line);
      border-radius: 12px; padding: 14px;
      color: var(--ink-muted); font-weight: 600; cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    }
    .add-child:hover { border-color: var(--rose); color: var(--rose); }

    /* Step 2 — dates */
    .session-list { display: grid; gap: 12px; }
    .session {
      display: grid; grid-template-columns: 24px 1fr auto; gap: 16px; align-items: center;
      padding: 16px 18px; border: 1.5px solid var(--line); border-radius: 12px;
      cursor: pointer; background: var(--snow);
    }
    .session:hover { border-color: var(--rose-300); background: var(--rose-50); }
    .session input[type="radio"] {
      appearance: none; width: 18px; height: 18px; border-radius: 50%;
      border: 1.5px solid var(--rose); background: var(--snow); margin: 0;
      display: grid; place-items: center;
    }
    .session input[type="radio"]:checked::after { content: ""; width: 9px; height: 9px; background: var(--rose); border-radius: 50%; }
    .session:has(input:checked) { border-color: var(--rose); background: var(--rose-50); }
    .session__title { font-weight: 700; font-size: 14px; color: var(--ink); }
    .session__sub { font-size: 12px; color: var(--ink-muted); margin-top: 2px; }
    .session__price { font-family: var(--serif); font-size: 18px; font-weight: 600; color: var(--pillar); }
    .session__capacity {
      font-size: 11px; color: var(--garden-700); margin-top: 4px; font-weight: 600;
    }
    .session__capacity--low { color: var(--warning-700); }
    .session__capacity--full { color: var(--ink-muted); }
    .session.is-full {
      opacity: .55; cursor: not-allowed;
    }
    .session.is-full input { pointer-events: none; }
    .session__waitlist {
      font-size: 11px; color: var(--ink-muted); font-style: italic;
    }

    /* Step 3 — waiver */
    .waiver-doc {
      max-height: 280px; overflow-y: auto;
      padding: 20px 24px;
      background: var(--rose-50); border: 1px solid var(--rose-100); border-radius: var(--radius);
      font-size: 13px; line-height: 1.6; color: var(--ink);
      margin-bottom: 16px;
    }
    .waiver-doc h4 { font-family: var(--serif); font-weight: 600; margin: 0 0 10px; font-size: 15px; color: var(--pillar); text-transform: uppercase; }
    .waiver-doc p { margin: 0 0 10px; }
    .waiver-checks { display: grid; gap: 12px; margin-top: 8px; }
    .waiver-check {
      display: grid; grid-template-columns: 22px 1fr; gap: 12px; align-items: start;
      font-size: 13px; cursor: pointer;
    }
    .waiver-check input[type="checkbox"] {
      appearance: none; width: 22px; height: 22px; border-radius: 6px;
      border: 1.5px solid var(--rose); background: var(--snow);
      display: grid; place-items: center; margin-top: 1px;
    }
    .waiver-check input[type="checkbox"]:checked { background: var(--rose); border-color: var(--rose); }
    .waiver-check input[type="checkbox"]:checked::after { content: "✓"; color: var(--snow); font-weight: 700; font-size: 14px; }

    .signature {
      display: grid; gap: 6px; margin-top: 16px;
    }
    .signature label { font-size: 13px; color: var(--ink-muted); font-weight: 600; }
    .sig-pad {
      width: 100%; min-height: 56px;
      border: 1.5px solid var(--line); border-radius: 8px;
      padding: 12px 14px;
      font-family: 'Brush Script MT', cursive; font-size: 26px;
      background: var(--snow); color: var(--pillar);
    }
    .sig-pad:focus { outline: 0; border-color: var(--rose); box-shadow: 0 0 0 3px var(--rose-100); }

    /* Step 4 — review */
    .review-section { margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px solid var(--line); }
    .review-section:last-of-type { border-bottom: 0; }
    .review-section__head {
      display: flex; justify-content: space-between; align-items: baseline;
      margin-bottom: 12px;
    }
    .review-section__title { font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--ink-muted); margin: 0; }
    .review-section__edit { font-size: 13px; color: var(--rose); font-weight: 600; cursor: pointer; background: none; border: 0; }
    .review-section__edit:hover { text-decoration: underline; }
    .review-row { display: flex; justify-content: space-between; gap: 12px; padding: 4px 0; font-size: 14px; }
    .review-row__label { color: var(--ink-muted); }
    .review-row__value { color: var(--ink); font-weight: 500; text-align: right; }
    .review-total {
      display: flex; justify-content: space-between;
      padding: 16px 0 4px;
      border-top: 2px solid var(--ink); margin-top: 12px;
      font-family: var(--serif); font-weight: 600; font-size: 22px;
      color: var(--pillar);
    }

    /* Footer nav */
    .step-nav {
      display: flex; justify-content: space-between; align-items: center;
      gap: 12px; margin-top: 24px;
    }
    .step-nav .btn { padding: 12px 28px; font-size: 14px; font-weight: 600; }
    .btn-back {
      background: transparent; border: 1.5px solid var(--line); color: var(--ink);
      padding: 12px 24px; border-radius: var(--radius); font-weight: 600; cursor: pointer;
      display: inline-flex; align-items: center; gap: 8px; font-size: 14px;
    }
    .btn-back:hover { border-color: var(--rose); color: var(--rose); }
    .btn-next {
      background: var(--button-primary); color: var(--snow); border: 0;
      padding: 12px 28px; border-radius: var(--radius); font-weight: 600; cursor: pointer;
      display: inline-flex; align-items: center; gap: 8px; font-size: 14px;
    }
    .btn-next:hover { background: var(--pillar-700); }
    .btn-next:disabled { background: var(--line); cursor: not-allowed; }

    @media (max-width: 720px) {
      .enroll-wrap { padding: 0 16px; }
      .panel { padding: 20px; }
      .stepper { padding: 16px 0; gap: 0; }
      .step + .step::before { width: 16px; margin-right: 8px; }
      .step__label { display: none; }
      .step.is-active .step__label { display: inline; }
      .session, .child-pick { grid-template-columns: 24px 1fr; }
      .session__price, .child-pick__age { grid-column: 2; padding-left: 0; padding-top: 6px; font-size: 14px; }
      .step-nav { flex-wrap: wrap; }
      .step-nav .btn-next, .step-nav .btn-back { flex: 1; padding: 12px 16px; min-width: 120px; }
      .panel__title { font-size: 20px; }
      .pm-grid, .pm-grid--3 { grid-template-columns: 1fr; }
    }
    @media (max-width: 540px) {
      .enroll-grid { grid-template-columns: 1fr; }
      .enroll-form .form-row { grid-template-columns: 1fr; }
      .enroll-review { padding: var(--s-4); }
      .enroll-submit { position: sticky; bottom: 0; background: var(--snow); padding: var(--s-4); border-top: 1px solid var(--line); z-index: 10; }
      .enroll-submit .btn { width: 100%; min-height: 56px; }
    }
</style>

<header class="enroll-head">
      <a href="javascript:history.back()"><i class="ph ph-arrow-left"></i> Back</a>
      <h1 class="enroll-title" id="enroll-title">Class Enrollment</h1>
      <p class="enroll-sub" id="enroll-sub">Complete 4 quick steps to reserve a spot.</p>
    </header>

    <ol class="stepper" role="list">
      <li class="step is-active" data-step-marker="1"><span class="step__dot">1</span><span class="step__label">Student</span></li>
      <li class="step" data-step-marker="2"><span class="step__dot">2</span><span class="step__label">Session</span></li>
      <li class="step" data-step-marker="3"><span class="step__dot">3</span><span class="step__label">Waiver</span></li>
      <li class="step" data-step-marker="4"><span class="step__dot">4</span><span class="step__label">Review</span></li>
    </ol>

    <!-- ---------- Step 1: Pick a student ---------- -->
    <section class="panel is-active" data-step="1">
      <h2 class="panel__title">Who's enrolling?</h2>
      <p class="panel__sub">Pick from your saved child profiles or add a new one.</p>
      <div class="child-picker" role="radiogroup" aria-label="Choose a student">
        <label class="child-pick">
          <input type="radio" name="student" value="daisy" checked>
          <div>
            <div class="child-pick__name">Daisy Sherlock</div>
            <div class="child-pick__meta">Allergies: none · Emergency contact on file</div>
          </div>
          <span class="child-pick__age">10 yrs</span>
        </label>
        <label class="child-pick">
          <input type="radio" name="student" value="peter">
          <div>
            <div class="child-pick__name">Peter Sherlock</div>
            <div class="child-pick__meta">Allergies: seafood · Emergency contact on file</div>
          </div>
          <span class="child-pick__age">12 yrs</span>
        </label>
      </div>
      <button type="button" class="add-child" data-mock="add-profile" data-mock-toast="Add-child form opens via Shopify customer metaobject in production."><i class="ph ph-plus"></i> Add a new child profile</button>

      <div class="step-nav">
        <button class="btn-back" type="button" disabled style="visibility:hidden">Back</button>
        <button class="btn-next" type="button" data-go-step="2">Continue <i class="ph ph-arrow-right"></i></button>
      </div>
    </section>

    <!-- ---------- Step 2: Pick a session ---------- -->
    <section class="panel" data-step="2">
      <h2 class="panel__title">Choose a session</h2>
      <p class="panel__sub">Available sessions for this program. Capacity updates in real time.</p>
      <div class="session-list" role="radiogroup" aria-label="Choose a session">
        <label class="session">
          <input type="radio" name="session" value="2026-spring" checked>
          <div>
            <div class="session__title">Spring 2026</div>
            <div class="session__sub">Mar 03 – May 28 · Mon/Wed/Fri 5–7 PM · Studio Room A</div>
            <div class="session__capacity">5 of 10 spots available</div>
          </div>
          <div class="session__price">$250</div>
        </label>
        <label class="session">
          <input type="radio" name="session" value="2026-summer">
          <div>
            <div class="session__title">Summer 2026</div>
            <div class="session__sub">Jun 09 – Aug 28 · Mon–Fri 9 AM–12 PM · Studio Room A</div>
            <div class="session__capacity session__capacity--low">⚠ Only 2 of 12 spots left</div>
          </div>
          <div class="session__price">$320</div>
        </label>
        <label class="session is-full">
          <input type="radio" name="session" value="2026-fall" disabled>
          <div>
            <div class="session__title">Fall 2026</div>
            <div class="session__sub">Sep 09 – Nov 22 · Tue/Thu 4–6 PM · Studio Room B</div>
            <div class="session__capacity session__capacity--full">Full — <a href="#" data-mock="waitlist" data-mock-toast="Joined waitlist. You'll be emailed if a spot opens (Shopify + Klaviyo in production).">Join waitlist</a></div>
          </div>
          <div class="session__price">$250</div>
        </label>
      </div>
      <div class="step-nav">
        <button class="btn-back" type="button" data-go-step="1"><i class="ph ph-arrow-left"></i> Back</button>
        <button class="btn-next" type="button" data-go-step="3">Continue <i class="ph ph-arrow-right"></i></button>
      </div>
    </section>

    <!-- ---------- Step 3: Waiver ---------- -->
    <section class="panel" data-step="3">
      <h2 class="panel__title">Liability waiver &amp; permissions</h2>
      <p class="panel__sub">Please review and acknowledge before continuing.</p>
      <div class="waiver-doc" tabindex="0" aria-label="Waiver document">
        <h3 style="font-size:22px;font-weight:600;margin:0 0 8px">Once Upon A Time, Inc. — Participant Agreement</h3>
        <p>I, the undersigned parent or legal guardian of the named participant, acknowledge that participation in arts education programs offered by Once Upon A Time, Inc. ("OUAT") includes physical activities such as dance, theater, and gardening that carry inherent risks of injury.</p>
        <p>I voluntarily assume those risks and release OUAT, its instructors, staff, and volunteers from any liability arising from ordinary negligence in connection with my child's participation, except where prohibited by law.</p>
        <p>I authorize OUAT staff to seek emergency medical care for my child if needed, and confirm that I have provided accurate emergency contact information.</p>
        <p>I understand that some classes (including the Gardening track) may include short field trips within walking distance of the studio. I authorize my child to participate in these supervised excursions.</p>
        <p>I grant OUAT permission to photograph or video-record my child during programs for the limited purpose of documenting and promoting OUAT's mission. I may revoke this permission in writing at any time at <a href="mailto:contact@onceuponatime.org">contact@onceuponatime.org</a>.</p>
        <p>This agreement is binding upon me, my heirs, and assigns. It is governed by the laws of the State of New York.</p>
      </div>
      <div class="waiver-checks">
        <label class="waiver-check"><input type="checkbox" name="waiver-1" required> <span>I have read and agree to the participant agreement above.</span></label>
        <label class="waiver-check"><input type="checkbox" name="waiver-2" required> <span>I authorize OUAT staff to provide emergency medical care if needed.</span></label>
        <label class="waiver-check"><input type="checkbox" name="waiver-3"> <span>I grant photo/video release for promotional use (optional).</span></label>
      </div>
      <div class="signature">
        <label for="sig">Type your full legal name as signature</label>
        <input class="sig-pad" id="sig" name="signature" placeholder="Claire Sherlock" autocomplete="name">
      </div>
      <div class="step-nav">
        <button class="btn-back" type="button" data-go-step="2"><i class="ph ph-arrow-left"></i> Back</button>
        <button class="btn-next" type="button" data-go-step="4" id="step3-next" disabled>Continue <i class="ph ph-arrow-right"></i></button>
      </div>
    </section>

    <!-- ---------- Step 4: Review + Pay ---------- -->
    <section class="panel" data-step="4">
      <h2 class="panel__title">Review &amp; pay</h2>
      <p class="panel__sub">Confirm your enrollment, then continue to secure checkout.</p>

      <div class="review-section">
        <div class="review-section__head">
          <h3 class="review-section__title">Student</h3>
          <button type="button" class="review-section__edit" data-go-step="1">Edit</button>
        </div>
        <div class="review-row"><span class="review-row__label">Name</span><span class="review-row__value" id="review-student">Daisy Sherlock (10 yrs)</span></div>
      </div>

      <div class="review-section">
        <div class="review-section__head">
          <h3 class="review-section__title">Session</h3>
          <button type="button" class="review-section__edit" data-go-step="2">Edit</button>
        </div>
        <div class="review-row"><span class="review-row__label">Program</span><span class="review-row__value" id="review-program">Seasonal Camps</span></div>
        <div class="review-row"><span class="review-row__label">Session</span><span class="review-row__value" id="review-session">Spring 2026 · Mon/Wed/Fri 5–7 PM</span></div>
        <div class="review-row"><span class="review-row__label">Studio</span><span class="review-row__value">Room A · 87-61 111th St, Richmond Hill</span></div>
      </div>

      <div class="review-section">
        <div class="review-section__head">
          <h3 class="review-section__title">Waiver</h3>
          <button type="button" class="review-section__edit" data-go-step="3">Edit</button>
        </div>
        <div class="review-row"><span class="review-row__label">Signed by</span><span class="review-row__value" id="review-sig">—</span></div>
        <div class="review-row"><span class="review-row__label">Photo/video release</span><span class="review-row__value" id="review-release">Not granted</span></div>
      </div>

      <div class="review-section">
        <div class="review-row"><span class="review-row__label">Subtotal</span><span class="review-row__value" id="review-subtotal">$250.00</span></div>
        <div class="review-row"><span class="review-row__label">Sibling discount</span><span class="review-row__value">$0.00</span></div>
      </div>

      <div class="review-total"><span>Total</span><span id="review-total">$250.00</span></div>

      <div class="step-nav">
        <button class="btn-back" type="button" data-go-step="3"><i class="ph ph-arrow-left"></i> Back</button>
        <button class="btn-next" type="button" id="checkout-btn" data-mock="checkout" data-mock-toast="Routes to Shopify Payments / Stripe checkout in production.">Continue to payment <i class="ph ph-lock-key"></i></button>
      </div>
    </section>

{% schema %}
{
  "name": "Enrollment \u2014 Main",
  "tag": "section",
  "settings": []
}
{% endschema %}
