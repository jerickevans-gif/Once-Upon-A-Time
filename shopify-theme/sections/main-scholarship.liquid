<style>
  @media (max-width: 540px) {
    .form-row-2col {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<section class='page-hero'>
  <div class='wrap'>
    <div class='page-hero__eyebrow'>Scholarships</div>
    <h1>Make Arts Education Affordable</h1>
    <p class='page-hero__sub'>
      Need-based aid up to 100% of program tuition. We awarded 48 scholarships in 2025 and don't plan to slow down.
    </p>
  </div>
</section>
<section class='wrap' style='max-width:720px;padding:48px 24px'>
  <div style='background:var(--rose-50);border-radius: var(--radius-md);padding:24px;margin-bottom:32px;font-size:14px;line-height:1.6'>
    <strong>Confidentiality:</strong> Your application is reviewed only by the scholarship committee. Information is
    never shared with instructors or other families.
  </div>
  <form id='scholarship-form' style='display:grid;gap:20px' novalidate>
    <div class='form-row-2col' style='display:grid;grid-template-columns:1fr 1fr;gap:14px'>
      <label class='field'
        ><span class='field__label'>Parent / Guardian First Name</span><input class='input' type='text' required
      ></label>
      <label class='field'><span class='field__label'>Last Name</span><input class='input' type='text' required></label>
    </div>
    <label class='field'><span class='field__label'>Email</span><input class='input' type='email' required></label>
    <label class='field'
      ><span class='field__label'>Phone</span><input class='input' type='tel' inputmode='tel' required
    ></label>
    <label class='field'
      ><span class='field__label'>Child's name + age</span
      ><input class='input' type='text' placeholder='Daisy, 10' required
    ></label>
    <label class='field'
      ><span class='field__label'>Program of interest</span
      ><select class='input' required>
        <option value=''>Select…</option>
        <option>Seasonal Camps</option>
        <option>Private Lessons</option>
        <option>Beginner Ballet</option>
        <option>Story Jazz</option>
        <option>Community Garden</option>
      </select></label
    >
    <label class='field'
      ><span class='field__label'>Household size</span><input class='input' type='number' min='1' required
    ></label>
    <label class='field'
      ><span class='field__label'>Annual household income (range)</span
      ><select class='input' required>
        <option value=''>Select…</option>
        <option>Under $25,000</option>
        <option>$25,000–$50,000</option>
        <option>$50,000–$75,000</option>
        <option>$75,000–$100,000</option>
        <option>Over $100,000</option>
      </select></label
    >
    <label class='field'
      ><span class='field__label'>Tell us about your circumstances (optional)</span
      >><textarea
        class='textarea'
        rows='4'
        style='width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:8px;background:var(--snow)'
      ></textarea>
    </label>
    <label style='display:grid;grid-template-columns:22px 1fr;gap:12px;font-size:14px;align-items:start'
      ><input type='checkbox' required style='width:22px;height:22px;margin-top:2px'>
      <span
        >I certify the information above is accurate and consent to confidential review by the scholarship committee.</span
      ></label
    >
    <button class='btn' type='submit' style='margin-top:8px'>Submit application</button>
  </form>
</section>
<script>
  document.getElementById('scholarship-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.target;
    let bad = false;
    for (const f of form.querySelectorAll('[required]')) {
      if (!f.value.trim()) {
        const lbl = f.closest('.field')?.querySelector('.field__label')?.textContent || 'This field';
        window.OUAT_setFieldError?.(f, lbl + ' is required');
        bad = true;
      } else if (f.type === 'email' && !/.+@.+\..+/.test(f.value)) {
        window.OUAT_setFieldError?.(f, 'Enter a valid email');
        bad = true;
      }
    }
    if (bad) return;
    if (window.OUAT_toast)
      window.OUAT_toast(
        'Application sent. We respond within 5 business days. (Routes to Shopify Forms / Klaviyo in production.)',
        { variant: 'mock', duration: 4500 }
      );
    form.reset();
  });
</script>

{% schema %}
{
  "name": "Scholarship \u2014 Main",
  "tag": "section",
  "settings": []
}
{% endschema %}
