<style>
/* Per-page button override (Figma AI Prototype): this frame uses --rose
       fill for Buttons/Button-brand, not the global Woody Brown default. */
    .btn { --btn-bg: var(--rose); --btn-bg-hover: var(--rose-700); --btn-ring: var(--rose); }
</style>

<section class="wrap" style="max-width:640px;padding:80px 24px;text-align:center">
      <div style="display:inline-flex;width:80px;height:80px;border-radius:50%;background:var(--garden-100);color:var(--garden-700);align-items:center;justify-content:center;font-size:42px;margin-bottom:18px"><i class="ph ph-check-circle"></i></div>
      <p style="font-size:11px;font-weight:700;letter-spacing:.25em;color:var(--garden-700);text-transform:uppercase;margin-bottom:8px">Order confirmed</p>
      <h1 style="font-family:var(--serif);font-size:42px;text-transform:uppercase;margin:0 0 12px;color:var(--pillar)">Thank you, <span id="order-name">Claire</span></h1>
      <p style="color:var(--ink-muted);max-width:46ch;margin:0 auto 24px;line-height:1.6">Your enrollment is locked in. A receipt and class details are on the way to your email.</p>
      <div style="background:var(--snow);border:1px solid var(--line);border-radius: var(--radius-md);padding:20px 24px;margin:0 auto 28px;max-width:400px;text-align:left">
        <div style="font-size:11px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--ink-muted)">Order #</div>
        <div id="order-id" style="font-family:Menlo,monospace;font-size:16px;color:var(--ink)">OUAT-2026-001</div>
      </div>
      <div style="display:inline-flex;gap:10px;flex-wrap:wrap;justify-content:center">
        <a class="btn" href="receipt.html" id="view-receipt-link"><i class="ph ph-receipt"></i> View receipt</a>
        <a class="btn btn--ghost" href="class-history.html">View enrollments</a>
      </div>
      <p style="margin-top:32px;font-size:13px;color:var(--ink-muted)">Next steps will arrive in your inbox within minutes. Reply to that email if anything looks off.</p>
    </section>

{% schema %}
{
  "name": "Order Confirmation \u2014 Main",
  "tag": "section",
  "settings": []
}
{% endschema %}
