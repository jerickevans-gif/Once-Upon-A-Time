<style>
body { background: var(--snow); }

    /* Class history cards */
    .class-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-5); }
    .class-card {
      background: var(--snow); border: 1px solid var(--line); border-radius: var(--radius-lg);
      overflow: hidden;
      display: grid; grid-template-rows: 200px auto;
    }
    .class-card__photo {
      position: relative;
      background-size: cover; background-position: center;
      display: flex; align-items: flex-start; justify-content: space-between;
      padding: var(--s-4);
    }
    .class-card--camps26 .class-card__photo { background-image: url("once-upon-a-time-assets/landing/jazz-hero.jpg"); }
    .class-card--camps25 .class-card__photo { background-image: url("once-upon-a-time-assets/landing/ballet-card.jpg"); }
    .class-card--private .class-card__photo { background-image: url("once-upon-a-time-assets/landing/story-jazz.jpg"); }
    .class-card--camps24 .class-card__photo { background-image: url("once-upon-a-time-assets/landing/jazz-hero.jpg"); }

    .class-card__status {
      background: var(--snow); color: var(--ink);
      padding: 4px 12px; border-radius: var(--radius-pill);
      font-size: var(--t-label); font-weight: 600;
    }
    .class-card__status--starting { background: var(--garden-100); color: var(--garden-700); }
    .class-card__status--happening { background: var(--rose-100); color: var(--rose-700); }
    .class-card__status--closed { background: var(--snow); color: var(--ink-muted); }
    .class-card__price {
      background: var(--snow); color: var(--ink);
      padding: 4px 12px; border-radius: var(--radius-pill);
      font-size: var(--t-label); font-weight: 700;
    }

    .class-card__body { padding: var(--s-5); display: grid; gap: var(--s-3); }
    .class-card__head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-3); flex-wrap: wrap; }
    .class-card__title { font-family: var(--serif); font-weight: 400; font-size: var(--t-h4); margin: 0; }
    .class-card__meta { font-size: var(--t-label); color: var(--ink-muted); }
    .chips { display: flex; gap: 8px; flex-wrap: wrap; }
    .chip { font-size: var(--t-micro); font-weight: 600; padding: 4px 10px; border-radius: var(--radius-pill); border: 1px solid var(--rose); color: var(--rose-700); background: transparent; }
    .chip--garden { border-color: var(--garden); color: var(--garden-700); }

    .class-card__links { display: flex; gap: var(--s-4); align-items: center; font-size: var(--t-label); }
    .class-card__links a { color: var(--rose); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }

    .class-card__footer { display: flex; gap: var(--s-3); padding-top: var(--s-3); }
    .class-card__footer .btn { flex: 1; }

    @media (max-width: 900px) { .class-grid { grid-template-columns: 1fr; } }
</style>

<div class="wrap account">
