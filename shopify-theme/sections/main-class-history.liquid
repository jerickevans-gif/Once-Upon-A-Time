                <span class="class-card__price">$250</span>
              </div>
              <div class="class-card__body">
                <h3 class="class-card__title">Seasonal Camps 2025</h3>
                <div class="class-card__meta">Start date · Mar 10 2025</div>
                <div class="chips"><span class="chip">Dance</span><span class="chip">Theater</span><span class="chip chip--garden">Gardening</span></div>
                <div class="class-card__footer">
                  <a class="btn btn--sm" href="seasonal-camps.html">View Details</a>
                  <a class="btn btn--sm btn--text" href="receipt.html?order=OUAT-2025-007">View Receipt</a>
                </div>
              </div>
            </article>
          </div>
        </div>

        <div class="acc-section">
          <h2 class="acc-section__title">Previous Classes</h2>
          <div class="class-grid">
            <article class="class-card class-card--private">
              <div class="class-card__photo">
                <span class="class-card__status class-card__status--closed">Closed</span>
                <span class="class-card__price">$250</span>
              </div>
              <div class="class-card__body">
                <h3 class="class-card__title">Private Sessions</h3>
                <div class="class-card__meta">Start date · June 02 2024</div>
                <div class="chips"><span class="chip">Acting</span></div>
                <div class="class-card__footer">
