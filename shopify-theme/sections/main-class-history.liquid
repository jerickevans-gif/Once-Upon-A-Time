                  <a class="btn btn--sm btn--text" href="receipt.html?order=OUAT-2024-052">View Receipt</a>
                </div>
              </div>
            </article>

            <article class="class-card class-card--camps24">
              <div class="class-card__photo">
                <span class="class-card__status class-card__status--closed">Closed</span>
                <span class="class-card__price">$250</span>
              </div>
              <div class="class-card__body">
                <h3 class="class-card__title">Seasonal Camps 2024</h3>
                <div class="class-card__meta">Start date · Mar 8 2024</div>
