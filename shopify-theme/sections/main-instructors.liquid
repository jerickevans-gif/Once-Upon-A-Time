<section class='page-hero'>
  <div class='wrap'>
    <div class='page-hero__eyebrow'>Our team</div>
    <h1>Instructors</h1>
    <p class='page-hero__sub'>Working artists and educators who bring real-world craft into every studio.</p>
  </div>
</section>
<section
  class='wrap'
  data-skeleton-list='6'
  style='padding:48px 0;display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:24px'
>
  <article class='instructor-card'>
    <div
      class='instructor-card__photo'
      style="background-image:url('once-upon-a-time-assets/portraits/patricia.png')"
    ></div>
    <div class='instructor-card__body'>
      <h2 class='instructor-card__name'>Luna Pinelli</h2>
      <p class='instructor-card__role'>Beginner Ballet · Jazz Dance</p>
      <p class='instructor-card__bio'>
        Soloist with NYC Ballet Workshop, 2018–22. Teaches kids 6–14 with patience and a sharp eye for posture.
      </p>
      <a class='instructor-card__link' href='instructor.html?name=luna-pinelli'
        >View bio <i class='ph ph-arrow-right' aria-hidden='true'></i
      ></a>
    </div>
  </article>
  <article class='instructor-card'>
    <div
      class='instructor-card__photo'
      style="background-image:url('once-upon-a-time-assets/portraits/mariah.png')"
    ></div>
    <div class='instructor-card__body'>
      <h2 class='instructor-card__name'>Mia Kim</h2>
      <p class='instructor-card__role'>Jazz Dance · Story Jazz</p>
      <p class='instructor-card__bio'>
        Choreographer for the Queens Performing Arts Festival. Jazz is her first language.
      </p>
      <a class='instructor-card__link' href='instructor.html?name=mia-kim'
