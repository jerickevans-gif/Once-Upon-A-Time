<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#FFF5EE">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- elsif template == 'index' -%}
    <meta name="description" content="{{ shop.description | default: 'Nonprofit arts education for children — dance, music, theater, and visual art in Queens, NY.' | escape }}">
  {%- endif -%}

  {% render 'meta-tags' %}
  {% render 'json-ld' %}

  <title>
    {%- if template == 'index' -%}
      {{ shop.name }}
    {%- elsif page_title -%}
      {{ page_title }} &mdash; {{ shop.name }}
    {%- else -%}
      {{ shop.name }}
    {%- endif -%}
  </title>

  <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset_url }}">
  <link rel="icon" type="image/png" sizes="16x16" href="{{ 'favicon-16.png' | asset_url }}">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ 'favicon-180.png' | asset_url }}">

  {%- comment -%} Self-hosted fonts {%- endcomment -%}
  <style>
    @font-face {
      font-family: "Voltra";
      src: url("{{ 'Voltra-Normal.ttf' | asset_url }}") format("truetype");
      font-weight: 400; font-style: normal; font-display: swap;
    }
    @font-face {
      font-family: "Chivo";
      src: url("{{ 'Chivo-Variable.ttf' | asset_url }}") format("truetype-variations"),
           url("{{ 'Chivo-Variable.ttf' | asset_url }}") format("truetype");
      font-weight: 100 900; font-style: normal; font-display: swap;
    }
    @font-face {
      font-family: "Chivo";
      src: url("{{ 'Chivo-Italic-Variable.ttf' | asset_url }}") format("truetype-variations"),
           url("{{ 'Chivo-Italic-Variable.ttf' | asset_url }}") format("truetype");
      font-weight: 100 900; font-style: italic; font-display: swap;
    }
    @font-face {
      font-family: "Phosphor";
      src: url("{{ 'Phosphor.woff2' | asset_url }}") format("woff2"),
           url("{{ 'Phosphor.woff' | asset_url }}") format("woff"),
           url("{{ 'Phosphor.ttf' | asset_url }}") format("truetype");
      font-weight: normal; font-style: normal; font-display: swap;
    }
  </style>

  {%- comment -%} Stylesheets — canonical CSS first, then Tailwind utilities, then page overrides {%- endcomment -%}
  <link rel="stylesheet" href="{{ 'design-system.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'components.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'tailwind.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'auth-modal.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'phosphor.css' | asset_url }}">

  {%- comment -%} Scripts — defer everything to keep first paint snappy {%- endcomment -%}
  <script src="{{ 'auth-modal.js' | asset_url }}" defer></script>
  <script src="{{ 'site.js' | asset_url }}" defer></script>

  {%- comment -%} GSAP + ScrollTrigger (CDN). Tree-shaken bundle would replace these in a build pipeline. {%- endcomment -%}
  {%- if settings.animations_reveal_on_scroll -%}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.15.0/gsap.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.15.0/ScrollTrigger.min.js" defer></script>
    <script src="{{ 'animations.js' | asset_url }}" defer></script>
  {%- endif -%}

  {{ content_for_header }}
</head>
<body class="template-{{ template | replace: '.', '-' }} color-{{ settings.color_scheme | default: 'background-1' }}">

  <a class="skip-link" href="#main">Skip to main content</a>

  {%- comment -%} Header group — sections composed via header-group.json (Dawn pattern) {%- endcomment -%}
  {% sections 'header-group' %}

  <main id="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- comment -%} Footer group — sections composed via footer-group.json {%- endcomment -%}
  {% sections 'footer-group' %}

</body>
</html>
