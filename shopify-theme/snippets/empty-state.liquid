<div class="empty-state" role="status">
  <div class="empty-state__icon"><i class="ph ph-{{ icon | default: 'magnifying-glass' }}" aria-hidden="true"></i></div>
  <h3 class="empty-state__title">{{ title | default: 'No results found' }}</h3>
  <p class="empty-state__body">{{ body | default: 'Try adjusting your search or filters.' }}</p>
  {% if show_clear %}
  <div class="empty-state__actions"><button type="button" class="btn btn--outline" data-clear-filters>Clear filters</button></div>
  {% endif %}
</div>
